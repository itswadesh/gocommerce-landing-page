# /gocommerce/ and /svelte-commerce/ are real pages now, not anchors, so they
# are deliberately absent from this file. A redirect rule matching either path
# would shadow the page it is supposed to reach.
#
# 301 rather than 302: these aliases are permanent, and a temporary redirect
# consolidates no signal on the destination.
/architecture     /#architecture                                  301
/quick-start      /#quick-start                                   301
/growth           /gocommerce/#roadmap                            301
/roadmap          /gocommerce/#roadmap                            301
/docs             https://github.com/itswadesh/gocommerce#readme  301

