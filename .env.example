# Build-time configuration for the website. Copy to .env; every value is
# optional and the site ships dark without it.
#
# Analytics. With none of these set, no consent banner renders and no
# third-party script is ever requested. With any set, nothing loads until the
# visitor clicks "Allow analytics". The privacy page lists whatever is set.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_SEGMENT_KEY=
PUBLIC_REO_ID=

# The live demo: a READ-ONLY demo account on admin.kitcommerce.store. With
# both set, "Open admin" becomes "Live demo" and links to the sign-in screen
# with these prefilled (carried in the URL fragment, which never reaches the
# server). Unset, the link is the plain sign-in screen. Never put an
# operator account here: whatever you set is published on the home page.
PUBLIC_DEMO_EMAIL=
PUBLIC_DEMO_PASSWORD=

# WhatsApp contact, as an international number with no plus, spaces or
# dashes (the wa.me format). Unset, the floating button and the footer link
# do not render.
PUBLIC_WHATSAPP=
