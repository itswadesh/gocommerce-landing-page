---
/**
 * The footer carries the whole map of the site, so every page links every
 * other page from its body — no page is reachable only through the header.
 *
 * Columns follow the shape shared by Medusa, Saleor, Vendure and Bagisto —
 * Product, Developers, Community, Company, Legal — with only the links that
 * are honest here, plus the Comparison and Ecommerce Tools columns in the
 * StoreHippo and Litekart shape. There is no careers page, status page, cloud
 * tier or terms of service, so none are listed. The word "partner" appears
 * once, for the one relationship that is one.
 *
 * Comparison lists the Shopify pages by name and the rest through the hub,
 * which links every one — twenty names would drown the other columns.
 */
interface Props { updated?: string }
const { updated } = Astro.props
const updatedText = updated ? new Date(updated + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : ''

const wa = import.meta.env.PUBLIC_WHATSAPP ?? ''
const ext = { target: '_blank', rel: 'noopener noreferrer' }

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/gocommerce/admin/', label: 'Admin — every screen' },
      { href: '/features/', label: 'Features' },
      { href: '/integrations/', label: 'Modules and integrations' },
      { href: '/#headless', label: 'Headless' },
      { href: '/solutions/marketplace/', label: 'Marketplace' },
      { href: '/solutions/b2b/', label: 'B2B' },
      { href: '/solutions/d2c/', label: 'Direct-to-consumer' },
      { href: '/solutions/multi-store/', label: 'Multi-store' },
      { href: '/svelte-commerce/', label: 'Storefront' },
      { href: '/svelte-commerce/themes/', label: 'Storefront themes' },
      { href: '/live-projects/', label: 'Live projects' },
      { href: '/gocommerce/#roadmap', label: 'Roadmap' },
      { href: 'https://github.com/itswadesh/svelte-commerce/blob/main/docs/CHANGELOG.md', label: 'Changelog', external: true },
      { href: '/pricing/', label: 'Pricing — free, for life' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { href: 'https://github.com/itswadesh/gocommerce#readme', label: 'Documentation', external: true },
      { href: 'https://github.com/itswadesh/gocommerce/blob/main/core/openapi.json', label: 'API reference (OpenAPI)', external: true },
      { href: '/#one-command', label: 'One-command Docker stack' },
      { href: '/gocommerce/#quickstart', label: 'GoCommerce quick start' },
      { href: '/svelte-commerce/#quickstart', label: 'Svelte Commerce quick start' },
      { href: 'https://github.com/itswadesh/gocommerce/tree/main/examples/store', label: 'Example store', external: true },
      { href: '/svelte-commerce/backends/', label: '26 backend integrations' },
      { href: '/go-svelte-ecommerce/', label: 'Architecture' },
      { href: '/gocommerce-svelte-commerce-connector/', label: 'Connector status' },
      { href: '/open-source/', label: 'Open source' },
      { href: '/vibe-coding-commerce/', label: 'Vibe-coding commerce' },
      { href: '/gocommerce/mcp/', label: 'MCP server for AI agents' },
      { href: 'https://github.com/itswadesh/gocommerce/blob/main/AGENTS.md', label: 'Agent guide (AGENTS.md)', external: true },
    ],
  },
  {
    title: 'Comparison',
    links: [
      { href: '/compare/kitcommerce-vs-shopify/', label: 'KitCommerce vs Shopify' },
      { href: '/compare/shopify-india-vs-kitcommerce/', label: 'Shopify India vs KitCommerce' },
      { href: '/compare/shopify-plus-vs-kitcommerce/', label: 'Shopify Plus vs KitCommerce' },
      { href: '/compare/kitcommerce-vs-bagisto/', label: 'KitCommerce vs Bagisto' },
      { href: '/compare/', label: 'All comparisons' },
    ],
  },
  {
    title: 'Ecommerce Tools',
    links: [
      { href: 'https://litekart.in/invalid-link-finder', label: 'URL Validator', external: true, isNew: true },
      { href: 'https://aerosearch.cloud', label: 'Aerosearch', external: true, isNew: true },
      { href: 'https://datamirror.cloud', label: 'DataMirror', external: true, isNew: true },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: 'https://discord.gg/GgdAeccwDR', label: 'Discord', external: true },
      { href: 'https://github.com/itswadesh/gocommerce', label: 'GoCommerce on GitHub', external: true },
      { href: 'https://github.com/itswadesh/svelte-commerce', label: 'Svelte Commerce on GitHub', external: true },
      { href: 'https://github.com/itswadesh/svelte-commerce/discussions', label: 'Discussions', external: true },
      { href: 'https://github.com/itswadesh/gocommerce/issues', label: 'Open issues', external: true },
      { href: 'https://github.com/itswadesh/gocommerce/issues', label: 'Contribute', external: true },
      { href: 'https://arialshop.com', label: 'A store running it', external: true },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about/', label: 'About — built by Swadesh Behera' },
      { href: '/blog/', label: 'Blog' },
      { href: '/contact/', label: 'Contact' },
      { href: '/integrations/#partner', label: 'Partners' },
      ...(wa ? [{ href: `https://wa.me/${wa}`, label: 'Contact on WhatsApp', external: true }] : []),
      { href: 'https://discord.gg/GgdAeccwDR', label: 'Contact on Discord', external: true },
      { href: 'https://github.com/itswadesh/gocommerce/issues/new', label: 'Report a problem', external: true },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy/', label: 'Privacy' },
      { href: 'https://github.com/itswadesh/gocommerce/blob/main/LICENSE', label: 'GoCommerce licence (MIT)', external: true },
      { href: 'https://github.com/itswadesh/svelte-commerce/blob/main/LICENSE', label: 'Svelte Commerce licence (MIT)', external: true },
      { href: '/about/#trademarks', label: 'Trademarks' },
      { href: '/sitemap/', label: 'Sitemap' },
      { href: '/llms.txt', label: 'llms.txt' },
    ],
  },
]
---
<footer>
  <div class="wrap footer-grid footer-grid-7">
    {cols.map((c) => (
      <nav class="footer-col" aria-label={c.title}>
        <h2>{c.title}</h2>
        {c.links.map((l) => (
          <a href={l.href} {...(l.external ? ext : {})}>{l.label}{l.isNew && <span class="new-badge">New</span>}</a>
        ))}
      </nav>
    ))}
  </div>

  <div class="wrap footer-brand-row">
    <div class="footer-brand">
      <p class="wordmark-name">kitcommerce.store</p>
      <p>KitCommerce is an open-source ecommerce platform. Its packages are GoCommerce, the backend and admin, and Svelte Commerce, the storefront — MIT licensed, used together or either one on its own.</p>
      <p class="footer-meta">MIT licensed — Go — SvelteKit — PostgreSQL</p>
    </div>
    <nav class="footer-social" aria-label="Elsewhere">
      <ul class="social">
        <li><a href="https://github.com/itswadesh" {...ext} data-ev="github_footer_click"><svg aria-hidden="true"><use href="#i-git"/></svg>GitHub</a></li>
        <li><a href="https://discord.gg/GgdAeccwDR" {...ext}><svg aria-hidden="true"><use href="#i-bot"/></svg>Discord</a></li>
        {wa && <li><a href={`https://wa.me/${wa}`} {...ext}><img src="/assets/brands/whatsapp.svg" width="15" height="15" alt="" loading="lazy">WhatsApp</a></li>}
      </ul>
    </nav>
  </div>

  <div class="wrap">
    <p class="footer-tm">Shopify, WooCommerce, Magento and every other product name and logo on this site are trademarks of their owners, used only to identify those products. No endorsement or affiliation is implied. <a href="/about/#trademarks">Trademarks</a></p>
  </div>

  <div class="wrap footer-base">
    <p>Built by <a href="https://github.com/itswadesh" {...ext}>itswadesh</a>.</p>
    {updated && <p class="footer-updated">This page updated <time datetime={updated}>{updatedText}</time></p>}
    <a class="partner" href="https://www.cloudflare.com" {...ext}><span>Hosting partner</span><img src="/assets/cloudflare.svg" width="20" height="20" alt="" loading="lazy"><span class="partner-name">Cloudflare</span></a>
    <button type="button" class="linklike" data-consent="reopen" hidden>Analytics preferences</button>
    <a href="#main">Back to top</a>
  </div>
</footer>
