---
/**
 * The 26-connector coverage table, rendered straight from data/connectors.json.
 * The data file carries its own provenance: which repository it was read from,
 * on what date, how coverage is measured, and the caveat that no connector has
 * been exercised against a live production instance. Nothing here is typed by
 * hand, so a wrong "wired" mark cannot be a transcription error.
 */
import data from '../data/connectors.json'

type State = 'wired' | 'unsupported' | 'unwired'
interface Connector { name: string; url: string; pkg: string; version: string; wired: number; total: number; cart: State; checkout: State; auth: State; gaps: string }

const rows = ([...data.connectors] as Connector[]).sort((a, b) => b.wired / b.total - a.wired / a.total || a.name.localeCompare(b.name))

// Three states, three shapes, not three colours. "Unsupported" is not a gap
// waiting to be filled: it is the platform having no such endpoint, and a
// contributor deciding what to build should not be pointed at it.
const MARK: Record<State, { cls: string; glyph: string; label: string }> = {
  wired: { cls: 'ok', glyph: '●', label: 'wired' },
  unsupported: { cls: 'no', glyph: '✕', label: 'no endpoint on the platform' },
  unwired: { cls: 'pending', glyph: '○', label: 'not yet wired' },
}
const Mark = (s: State) => MARK[s] ?? MARK.unwired
---
<p class="tbl-note">
  Read from <code>{data._source}</code> on <time datetime={data._read}>{data._read}</time>. {data._measured}
</p>

<div class="tbl-scroll">
  <table class="matrix">
    <caption class="vh">Connector coverage across {rows.length} commerce platforms</caption>
    <thead>
      <tr>
        <th scope="col">Platform</th>
        <th scope="col">Coverage</th>
        <th scope="col" class="mark">Cart</th>
        <th scope="col" class="mark">Checkout</th>
        <th scope="col" class="mark">Auth</th>
        <th scope="col">Known gaps</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((c) => {
        const pct = Math.round((c.wired / c.total) * 100)
        return (
          <tr>
            <th scope="row"><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a></th>
            <td class="cov"><span class="bar" style={`--pct:${pct}%`}><span class="num">{c.wired}/{c.total}</span></span></td>
            {([c.cart, c.checkout, c.auth] as State[]).map((s) => (
              <td class={`mark ${Mark(s).cls}`}><span aria-hidden="true">{Mark(s).glyph}</span><span class="vh">{Mark(s).label}</span></td>
            ))}
            <td class="gaps">{c.gaps ? c.gaps : <span class="none">none</span>}</td>
          </tr>
        )
      })}
      {/* Not in the data because the coverage script has not measured it: the
          connector lives in the GoCommerce repository, not in Svelte
          Commerce's. Listed last, on purpose, so the page answers the question
          everyone arrives with. Marks are from its README: cart and checkout
          are mapped; shopper sign-in is not (checkout is guest checkout). */}
      <tr class="row-pending">
        <th scope="row"><a href="/gocommerce-svelte-commerce-connector/">GoCommerce</a></th>
        <td class="cov"><span class="num none">—</span></td>
        <td class="mark ok"><span aria-hidden="true">●</span><span class="vh">wired</span></td>
        <td class="mark ok"><span aria-hidden="true">●</span><span class="vh">wired</span></td>
        <td class="mark pending"><span aria-hidden="true">○</span><span class="vh">not yet wired</span></td>
        <td class="gaps">early connector, 0.1.0 — not measured by the coverage script; no customer accounts or search index</td>
      </tr>
    </tbody>
  </table>
</div>
