---
import Base from '../layouts/Base.astro'
import Faq from '../components/Faq.astro'
import { counts, connector } from '../lib/facts'

const path = '/gocommerce-svelte-commerce-connector/'
const abs = (p: string) => new URL(p, Astro.site!).href

const graph = [
  { '@type': 'WebPage', '@id': abs(path + '#page'), url: abs(path), name: 'GoCommerce ↔ Svelte Commerce Connector — Status', isPartOf: { '@id': abs('/#site') }, inLanguage: 'en', mentions: [{ '@id': abs('/gocommerce/#app') }, { '@id': abs('/svelte-commerce/#app') }] },
]

const faq = [
  { q: 'Can I connect Svelte Commerce to GoCommerce today?', a: `Yes, through an early connector. @misiki/gocommerce-connector ${counts.connectorVersion} is on npm, first published on 2 September 2026. Install it in a Svelte Commerce checkout, set PUBLIC_GOCOMMERCE_API_URL to your GoCommerce instance, and the storefront can browse the catalogue, fill a cart, check out and look up an order. Sign-in, the address book and order history need GoCommerce’s identity module, and no store is known to run the pair in production.` },
  { q: 'What does “early” mean here?', a: `It is ${counts.connectorVersion}, first published on 2 September 2026. The path from a shelf to a placed order works, and its tests run against a real GoCommerce engine rather than a mock. What it lacks is production mileage: no store is known to run Svelte Commerce on GoCommerce in production, so nothing has yet met a real catalogue or real shoppers. Build on it deliberately, and place test orders before real ones.` },
  { q: 'What does it not do?', a: `Shopper sign-in, the address book and order history go through GoCommerce’s identity module; without it, as in a test stack on ${counts.connectorTestedOn}, they do not work, and an order is read back with the access token checkout returned. Account deletion, blogs, banners, reels, chat, warranties, deals and uploads are not mapped: a list of them answers empty, and a write or a single record throws, naming the service. At checkout it offers cash on delivery, Razorpay and the store’s first hosted-page gateway.` },
  { q: 'How do I install it?', a: 'Run npm i @misiki/gocommerce-connector in your Svelte Commerce checkout and set PUBLIC_GOCOMMERCE_API_URL to where GoCommerce answers, for example http://127.0.0.1:8080. Install one connector at a time: the backend is whichever @misiki/*-connector package.json has, so remove the Litekart and Vendure connectors Svelte Commerce ships with.' },
  { q: `Is GoCommerce one of the ${counts.backends} backends?`, a: `No. The ${counts.backends} are the connectors whose coverage the backends page measures with a script, and the GoCommerce connector is not in that set. It lives in its own repository, misiki-in/gocommerce-connector, and this page describes it instead.` },
  { q: 'Does this mean the two packages are now one wired stack?', a: `They are two packages of one platform with an early connector between them. Both are still useful on their own — GoCommerce behind any client, Svelte Commerce in front of ${counts.backends} other backends — and the connector is the newest and least proven of the three.` },
]

// The ledger. One state per line, and the states mean what the legend says.
const ledger = [
  { state: 'ship', title: 'Published to npm', body: `@misiki/gocommerce-connector ${counts.connectorVersion}, first published on 2 September 2026. The source is in its own repository, misiki-in/gocommerce-connector.` },
  { state: 'ship', title: 'Catalogue', body: 'productService lists, filters, sorts and paginates, and fetches by slug, id or SKU, with variants. categoryService serves the tree and category pages; collectionService serves curated lists and a collection page.' },
  { state: 'ship', title: 'Cart', body: 'open, add, change quantity, remove, apply a discount code, set the email.' },
  { state: 'ship', title: 'Checkout', body: `cash on delivery, Razorpay and the store’s first hosted-page gateway (Adyen, Paddle, Lemon Squeezy, Creem, Hyperswitch or RevenueCat), shipping rates, and placing the order. Cash on delivery worked end to end in a test on ${counts.connectorTestedOn}.` },
  { state: 'ship', title: 'Order lookup', body: `one order, by its number and the access token checkout returned. In the same test the order-success page showed the full order.` },
  { state: 'ship', title: 'Money and missing fields', body: 'prices are converted from the engine’s minor units per currency, not by a constant 100. Fields the engine lacks are not invented: with no popularity score, “most popular” sorts nothing, and mrp equals the price.' },
  { state: 'dev', title: 'Production use', body: 'none known. No store is known to run Svelte Commerce on GoCommerce in production; the tests run against a real engine, not a real shop.' },
  { state: 'dev', title: 'Shopper accounts', body: 'sign-in by email and password or by a code texted to a phone, the address book and order history, through GoCommerce’s identity module. They did not work in the test stack, which ran without it.' },
  { state: 'dev', title: 'Guest orders', body: 'opening an order with its number and the email or phone on it, with a 4-digit code sent to either, or from the link in its emails. Not yet tested end to end here.' },
  { state: 'dev', title: 'Pages and theme', body: 'the home page, the product and collection templates, the header, the footer and the theme settings a shop sets in GoCommerce’s Themes, with the editor’s live preview; the store’s own logo, dark logo and icon; its address, map and opening hours on the contact page. Not yet tested end to end here.' },
  { state: 'dev', title: 'Basket and product page extras', body: 'add-ons, suggestions, the codes a shop lists, the free-delivery bar, highlights, a free gift, product videos, the sold count and PIN code autofill. Not yet tested end to end here.' },
  { state: 'dev', title: 'Search, pictures and the storefront modules', body: 'search through Meilisearch when the store switches it on, and the database when it cannot answer; pictures resized by the engine to the width shown; reviews, wishlists, content pages, menus, FAQ, newsletter and contact through the matching GoCommerce modules. Not yet tested end to end here.' },
  { state: 'plan', title: 'What it does not map', body: 'account deletion, blogs, banners, reels, chat, warranties, deals and uploads. Their lists answer empty, and anything that writes or opens one record throws, naming the service.' },
  { state: 'plan', title: 'Other payment methods', body: 'the storefront’s checkout offers no Stripe, Cashfree, Clover or Helcim, nor a second hosted-page gateway, and its Stripe and Cashfree flows throw, naming the service. checkoutService.checkout(code) reaches every method the engine has switched on, for a storefront that draws its own payment step.' },
]
const ext = { target: '_blank', rel: 'noopener noreferrer' }

const installCode = `<span class="cm"># one connector at a time — remove the two Svelte Commerce ships with</span>
npm uninstall @misiki/litekart-connector @misiki/vendure-connector
npm i @misiki/gocommerce-connector

<span class="cm"># tell the storefront where GoCommerce answers</span>
<span class="b">echo</span> PUBLIC_GOCOMMERCE_API_URL=http://127.0.0.1:8080 &gt;&gt; .env`
---
<Base
  title="GoCommerce ↔ Svelte Commerce Connector — Status"
  description={`The Svelte Commerce connector for GoCommerce: early, ${counts.connectorVersion} on npm. What works from shelf to placed order, what does not, how to install it, and how to help.`}
  path={path}
  ogTitle="GoCommerce ↔ Svelte Commerce Connector — Status"
  ogDescription={`Early, ${counts.connectorVersion} on npm. What works, what does not, how to install it, and how to help.`}
  ogImageAlt="Status of the connector between GoCommerce and Svelte Commerce"
  nav="connector"
  crumbs={[{ name: 'Connector status', href: path }]}
  graph={graph}
  faq={faq}
>
  <section class="wrap page-head">
    <h1>GoCommerce ↔ Svelte Commerce connector</h1>
    <div class="status-banner">
      <p class="status-line"><span class="dot dot-dev" aria-hidden="true"></span><span><b>Status: early ({counts.connectorVersion}).</b> Published on npm as <code>@misiki/gocommerce-connector</code>.</span></p>
      <p>In a test on {counts.connectorTestedOn}, {counts.connectorTested} worked end to end. Sign-in, the address book and order history need GoCommerce’s identity module. No store is known to run Svelte Commerce on GoCommerce in production.</p>
    </div>
    <p class="lede">This page exists so the answer is one link rather than an inference: what the connector does, what it does not, and how to try it.</p>
  </section>

  <section id="install" class="section wrap" aria-labelledby="install-title">
    <h2 id="install-title">Install it</h2>
    <p class="section-lede">In a Svelte Commerce checkout, with a GoCommerce instance running somewhere the storefront can reach.</p>
    <div class="code-block">
      <div class="code-head"><p>Swap the connector, point it at GoCommerce</p><button class="copy" data-copy="code-connector-install">Copy</button></div>
      <pre id="code-connector-install"><code set:html={installCode} /></pre>
    </div>
    <p class="fineprint">Install one connector at a time: the backend is whichever <code>@misiki/*-connector</code> <code>package.json</code> has, and two would fight over the same alias. The package’s <a href={`${connector.repository}#readme`} {...ext}>README</a> is the authority on its details; the package itself is on <a href="https://www.npmjs.com/package/@misiki/gocommerce-connector" {...ext}>npm</a>.</p>
  </section>

  <section id="architecture" class="section wrap" aria-labelledby="arch-title">
    <h2 id="arch-title">Current architecture</h2>
    <p class="section-lede">Both halves exist and are solid. The piece between them exists too, and it is the early one.</p>
    <div class="arch">
      <div class="arch-row arch-store">
        <h3>Svelte Commerce</h3>
        <p>Calls a connector package. Imports none by name — <code>$connector</code> resolves from <code>package.json</code>.</p>
      </div>
      <p class="arch-wire arch-wire-gap"><span>@misiki/gocommerce-connector {counts.connectorVersion} — early</span></p>
      <div class="arch-row arch-engine">
        <h3>GoCommerce</h3>
        <p>Serves {counts.apiOperations} documented operations over REST, published as OpenAPI.</p>
      </div>
    </div>
    <p class="fineprint">Svelte Commerce reaches every backend through a connector implementing a shared 43-service surface — <code>product</code>, <code>cart</code>, <code>checkout</code>, <code>order</code>, <code>auth</code>, <code>address</code> and the rest. The <a href="/svelte-commerce/backends/">backends page measures 26 of them</a>; the GoCommerce connector is not in that set. It implements the commerce path and refuses the rest by name. The two halves are described on the <a href="/go-svelte-ecommerce/">architecture page</a>.</p>
  </section>

  <section id="ledger" class="section wrap" aria-labelledby="ledger-title">
    <h2 id="ledger-title">What exists, what does not</h2>
    <ul class="legend">
      <li><span class="dot dot-ship" aria-hidden="true"></span>Works in {counts.connectorVersion}</li>
      <li><span class="dot dot-dev" aria-hidden="true"></span>Early — needs a module, or not yet proven</li>
      <li><span class="dot dot-plan" aria-hidden="true"></span>Not covered: throws, naming the service</li>
    </ul>
    <div class="mkt">
      <ul class="growth-list">
        {ledger.map((l) => (
          <li>
            <span class={`dot dot-${l.state}`} aria-hidden="true"></span>
            <p><span class="vh">{l.state === 'ship' ? 'Works: ' : l.state === 'dev' ? 'Early: ' : 'Not covered: '}</span><b>{l.title}</b> — {l.body}</p>
          </li>
        ))}
      </ul>
    </div>
    <p class="fineprint">Which release brought each page and theme setting, and which Svelte Commerce branch draws it, is on <a href="/features/storefront/">storefront and themes</a>.</p>
  </section>

  <section id="limitations" class="section wrap" aria-labelledby="lim-title">
    <h2 id="lim-title">Known limitations</h2>
    <p class="section-lede">What is true of {counts.connectorVersion} as published.</p>
    <div class="tri">
      <div class="tri-item">
        <h3>A stable contract, not a proven one</h3>
        <p>GoCommerce is 1.0, so the API the connector binds to will not move without a major version. What that does not supply is production mileage: no store is known to run GoCommerce in production yet, let alone the pair, so the connector will meet whatever the first real catalogue exposes.</p>
      </div>
      <div class="tri-item">
        <h3>Partial, and loud about it</h3>
        <p>The connector refuses what the engine does not do with an error that names the service, rather than returning empty. It has no score on the backends page, because the script that measures the 26 has not measured it, so its coverage is described here rather than numbered.</p>
      </div>
      <div class="tri-item">
        <h3>No benchmarks either way</h3>
        <p>Nothing has been published about GoCommerce’s performance, so nothing can honestly be said about the pair’s. That stays true until somebody measures it.</p>
      </div>
    </div>
  </section>

  <section id="contribute" class="section wrap" aria-labelledby="con-title">
    <h2 id="con-title">How to help</h2>
    <div class="contrib">
      <ul class="contrib-list">
        <li><b>Run it against a real store.</b> Put it in front of a real GoCommerce catalogue and report what breaks. The standing weakness of every Svelte Commerce connector is that none has been run against a live production store; being the first would matter more than new code.</li>
        <li><b>Start from the tests.</b> They run against a running GoCommerce, not a mock, and skip loudly when there is nothing to talk to. A mock would test the connector against an idea of the engine rather than the engine.</li>
        <li><b>Keep refusals loud.</b> A service the connector does not map throws <code>UnsupportedByGoCommerce</code>. Making one return an empty list instead turns a missing feature into a heading with nothing under it.</li>
        <li><b>Do not stub auth.</b> The convention across every connector is to throw rather than mint a session — a stub that logs anyone in is an auth bypass, not a placeholder.</li>
      </ul>
      <div class="contrib-cta">
        <p>The backend carries <b>over {counts.testsFloor} tests</b> and a documented contract for every route, so the connector has something precise to build against.</p>
        <a class="button" href="https://github.com/itswadesh/gocommerce/issues" {...ext}>GoCommerce issues</a>
        <a class="button secondary" href="https://github.com/itswadesh/svelte-commerce/discussions/new/choose" {...ext}>Svelte Commerce discussions</a>
        <a class="button secondary" href="https://discord.gg/GgdAeccwDR" {...ext}>Discord</a>
      </div>
    </div>
  </section>

  <Faq items={faq} title="Connector questions" />

  <section class="closing wrap">
    <h2>Either package is useful on its own</h2>
    <p>The connector is early, and this page says what it does not do. GoCommerce and Svelte Commerce are each useful without it.</p>
    <div class="actions">
      <a class="button" href="/gocommerce/">Explore GoCommerce</a>
      <a class="button" href="/svelte-commerce/">Explore Svelte Commerce</a>
      <a class="button secondary" href="/svelte-commerce/backends/">See the other {counts.backends} backends</a>
    </div>
  </section>
</Base>
