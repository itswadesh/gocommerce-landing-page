---
/**
 * Two prices, one each for the two ways to run a store. A store hosted on
 * kitcommerce.store pays a share of each successful sale; the MIT code, run on
 * your own server, costs nothing. Both figures come from src/data/pricing.json
 * (the owner's decision of 26 October 2026, in docs/decisions.md), and the page
 * says nothing about the hosted option beyond that figure and its sign-up.
 *
 * The Shopify figures are its own price list for the visitor's currency
 * (src/data/prices.json), read on the date shown; the arithmetic is the only
 * thing added.
 */
import Base from '../layouts/Base.astro'
import Faq from '../components/Faq.astro'
import LinkCards from '../components/LinkCards.astro'
import CurrencyPicker from '../components/CurrencyPicker.astro'
import Priced from '../components/Priced.astro'
import Variants from '../components/Variants.astro'
import { byCurrency, formatMoney, shopifyMarkets } from '../lib/money'
import { hostedFee, signupUrl } from '../lib/pricing'
import { compareCard, featuredComparisons } from '../lib/related'

const path = '/pricing/'
const abs = (p: string) => new URL(p, Astro.site!).href
const ext = { target: '_blank', rel: 'noopener noreferrer' }
const hosted = `${hostedFee} of each successful sale`

const markets = shopifyMarkets()
const plans = ['basic', 'grow', 'advanced']
const inMarket = byCurrency((c) => markets[c].name)
const zero = byCurrency((c) => formatMoney(0, markets[c].list.currency))
const longDate = (iso: string) => new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
const shopifyLists = [...new Map(Object.values(markets).map((m) => [m.list.url, m])).values()]

const graph = [
  {
    '@type': 'WebPage', '@id': abs(path + '#page'), url: abs(path), name: `Pricing: ${hosted} hosted on kitcommerce.store, free to run yourself`, isPartOf: { '@id': abs('/#site') }, inLanguage: 'en',
    about: [{ '@id': abs('/gocommerce/#app') }, { '@id': abs('/svelte-commerce/#app') }],
  },
]

const faq = [
  { q: 'What does a store hosted on kitcommerce.store cost?', a: `${hosted}. Start one with the Start a store button on this page.` },
  { q: 'Is running it myself really free?', a: 'Yes. GoCommerce and Svelte Commerce are MIT licensed. The licence has no expiry, no seat count and no revenue cap, takes 0% of your sales, and a copy you have downloaded stays MIT whatever happens to the packages later.' },
  { q: 'Is there a Plus plan, a pro tier or an enterprise edition?', a: `No. A store is either hosted on kitcommerce.store, for ${hosted}, or run on your own server for free. The MIT code has every module, every admin screen and every theme in it; nothing is held back for a higher tier because there is no higher tier.` },
  { q: 'When I run it myself, are there hidden fees: per order, per product, per staff account?', a: 'None. Nobody takes a percentage of your sales, counts your products or charges for another admin user. The fees you pay are your payment gateway’s own, on its own terms.' },
  { q: 'Can I white-label it and sell it to my clients?', a: 'Yes. MIT lets you rename both packages, restyle the storefront and the admin, and ship them under your own brand, for yourself or for clients. Keep the copyright notice in the source; that is the only condition.' },
  { q: 'What will I actually spend running it myself?', a: `Whatever your server, domain and payment gateway cost, plus the time of whoever runs it. A small store can start on one small VPS. For a store with no developer, hosting it on kitcommerce.store for ${hosted} may cost less than that time.` },
  { q: 'Where does help come from?', a: 'GitHub issues, discussions and the Discord, where the people who build both packages answer.' },
]
---
<Base
  title={`Pricing: ${hostedFee} of Each Sale Hosted, Free to Self-Host`}
  description={`Stores hosted on kitcommerce.store pay ${hosted}. GoCommerce and Svelte Commerce stay free and MIT licensed to run yourself, at 0% of your sales.`}
  path={path}
  ogTitle={`${hostedFee} of each sale, hosted. Free to run yourself.`}
  ogDescription={`Start a store on kitcommerce.store for ${hosted}, or run the MIT code on your own server for free.`}
  nav="pricing"
  crumbs={[{ name: 'Pricing', href: path }]}
  graph={graph}
  faq={faq}
  prices
>
  <section class="wrap price-hero">
    <p class="kicker">Pricing</p>
    <h1>{hostedFee} of each sale hosted. Free to run yourself.</h1>
    <p class="lede">Two ways to run a store. Host it on kitcommerce.store and pay {hosted}. Or run GoCommerce and Svelte Commerce on your own server: MIT licensed, no plan, no fee on your orders, no cap on your sales.</p>
    <div class="duo-grid">
      <div class="duo-card">
        <p class="duo-card-role">Hosted on kitcommerce.store</p>
        <p class="price-big">{hostedFee}</p>
        <p class="price-per">of each successful sale</p>
        <div class="actions">
          <a class="button" href={signupUrl} {...ext} data-ev="signup_click">Start a store</a>
        </div>
      </div>
      <div class="duo-card duo-card-engine">
        <p class="duo-card-role">Self-hosted, MIT licensed</p>
        <p class="price-big">Free</p>
        <p class="price-per">0% of your sales, no expiry</p>
        <div class="actions">
          <a class="button" href="/#one-command" data-ev="quickstart_click">Deploy in minutes</a>
          <a class="button secondary" href="https://github.com/itswadesh/gocommerce" {...ext} data-ev="github_click">Get the source</a>
        </div>
      </div>
    </div>
  </section>

  <section id="includes" class="section wrap" aria-labelledby="includes-title">
    <h2 id="includes-title">Everything is in the MIT code</h2>
    <p class="section-lede">Run it yourself and you get all of it. There is no higher plan for anything to be missing from.</p>
    <ul class="evidence">
      <li><svg aria-hidden="true"><use href="#i-server"/></svg><b>GoCommerce</b><span>The backend: catalogue, carts, checkout, orders, inventory, discounts, price lists, channels — with 61 admin screens compiled in.</span></li>
      <li><svg aria-hidden="true"><use href="#i-store"/></svg><b>Svelte Commerce</b><span>The storefront: server-rendered SvelteKit, running against 26 commerce backends.</span></li>
      <li><svg aria-hidden="true"><use href="#i-plug"/></svg><b>51 modules</b><span>Razorpay, Stripe, Shiprocket, Delhivery, India Post, MSG91, search, feeds and more — <a href="/integrations/">all of them</a>.</span></li>
      <li><svg aria-hidden="true"><use href="#i-tag"/></svg><b>79 themes</b><span>Live storefront demos you can <a href="/svelte-commerce/themes/">open and copy</a>.</span></li>
      <li><svg aria-hidden="true"><use href="#i-bot"/></svg><b>The MCP module</b><span>19 tools that let an AI agent run the store through the same services as the API.</span></li>
      <li><svg aria-hidden="true"><use href="#i-git"/></svg><b>Every future commit</b><span>Updates are commits to public repositories. Pull them when you choose.</span></li>
    </ul>
  </section>

  <section id="replaces" class="section wrap" aria-labelledby="replaces-title">
    <h2 id="replaces-title">What running it yourself replaces</h2>
    <p class="section-lede">Shopify’s own price list for <Variants v={inMarket} />, billed yearly, added up. Shopify charges the fee per order when a payment provider other than Shopify Payments takes the payment.</p>
    <CurrencyPicker refs={['shopify/basic-yearly']} />
    <div class="tbl-scroll">
      <table class="reltable vs">
        <caption>Plan fees alone, before any per-order fee: Shopify against self-hosted GoCommerce and Svelte Commerce</caption>
        <thead><tr><th scope="col"><span class="vh">Plan</span></th><th scope="col">Per month</th><th scope="col">One year</th><th scope="col">Three years</th><th scope="col">Fee per order</th></tr></thead>
        <tbody>
          {plans.map((p, i) => (
            <tr><th scope="row">Shopify {markets.INR.plans[i].name}</th><td><Priced s={`{p:shopify/${p}-yearly}`} /></td><td><Priced s={`{p:shopify/${p}-yearly*12}`} /></td><td><Priced s={`{p:shopify/${p}-yearly*36}`} /></td><td><Variants v={byCurrency((c) => `${markets[c].plans[i].fee}%`)} /></td></tr>
          ))}
          <tr><th scope="row">GoCommerce + Svelte Commerce, self-hosted</th><td><Variants v={zero} /></td><td><Variants v={zero} /></td><td><Variants v={zero} /></td><td>0%</td></tr>
        </tbody>
      </table>
    </div>
    <p class="fineprint">Sources: Shopify’s price lists for {shopifyLists.map((m, i) => <>{i > 0 && ', '}<a href={m.list.url} {...ext}>{m.name}</a>{m.list.read !== shopifyLists[0].list.read && ` (as archived on ${longDate(m.list.read)})`}</>)}, read on {longDate(shopifyLists[0].list.read)}, and Shopify’s <a href="https://help.shopify.com/en/manual/your-account/manage-billing/billing-charges/types-of-charges/third-party-charges/third-party-transaction-fees" {...ext}>third-party transaction fees</a>. The full comparison, with where Shopify is the better choice, is on <a href="/compare/kitcommerce-vs-shopify/">KitCommerce vs Shopify</a>.</p>
  </section>

  <section id="costs" class="section wrap" aria-labelledby="costs-title">
    <h2 id="costs-title">What running it yourself still costs</h2>
    <p class="section-lede">Free software is not a free store. These are yours, and they are the honest price of owning it.</p>
    <div class="tri">
      <div class="tri-item">
        <h3>A server and a database</h3>
        <p>One Go binary and one PostgreSQL. A small store can start on a small VPS; the bill is your host’s, not ours.</p>
      </div>
      <div class="tri-item">
        <h3>Your payment gateway’s fee</h3>
        <p>Razorpay, Stripe or whichever you connect charges its own rate. Nothing is added on top of it.</p>
      </div>
      <div class="tri-item">
        <h3>Someone’s time</h3>
        <p>Deploying, upgrading and extending it is work — yours, or a developer’s. For a store without one, hosting on kitcommerce.store for {hosted} may cost less than that time.</p>
      </div>
    </div>
  </section>

  <LinkCards id="compared" title="What other platforms charge" items={featuredComparisons.map(compareCard)}>
    <p class="section-lede">Each comparison prices the other platform from its own page, on the date shown, and says where it is the better choice. <a href="/compare/">All comparisons</a>.</p>
  </LinkCards>

  <Faq items={faq} title="Questions about the price" />

  <section class="closing wrap">
    <h2>Hosted for {hostedFee} of each sale, or yours to run</h2>
    <p>Start a store on kitcommerce.store, or bring up the API and the admin on your own machine with one command.</p>
    <div class="actions">
      <a class="button" href={signupUrl} {...ext} data-ev="signup_click">Start a store</a>
      <a class="button secondary" href="/#one-command" data-ev="quickstart_click">Deploy in minutes</a>
      <a class="button secondary" href="/compare/">Compare platforms</a>
    </div>
  </section>
</Base>
