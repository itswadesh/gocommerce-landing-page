---
/**
 * The homepage proves, in order: this is real, this is mature, I can inspect
 * it, I can run it quickly, I control it, my agents can work with it. Every
 * section is a screenshot, a number or a diagram with a door to the page
 * that explains it; the explaining happens on those pages, not here.
 */
import Base from '../layouts/Base.astro'
import Faq from '../components/Faq.astro'

const path = '/'
const site = Astro.site!
const abs = (p: string) => new URL(p, site).href

// Repository figures are fetched at build time so a deploy carries the
// current count; the fallback is the last value measured by hand. app.js
// refreshes them again in the browser if GitHub answers.
async function repoStats(repo: string, fallback: { stars: number; forks: number }) {
  try {
    const ctrl = new AbortController()
    const timer = setTimeout(() => ctrl.abort(), 5000)
    const r = await fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'kitcommerce.store build' }, signal: ctrl.signal })
    clearTimeout(timer)
    if (!r.ok) return fallback
    const j = await r.json()
    return { stars: typeof j.stargazers_count === 'number' ? j.stargazers_count : fallback.stars, forks: typeof j.forks_count === 'number' ? j.forks_count : fallback.forks }
  } catch { return fallback }
}
const sv = await repoStats('itswadesh/svelte-commerce', { stars: 1813, forks: 335 })
const n = (x: number) => x.toLocaleString('en')

// The live demo. With a read-only demo account configured, the admin link
// carries its credentials in the URL fragment — never sent to the server, so
// never in an access log or a Referer — and the admin's sign-in form prefills
// from it. With none configured, the link is the plain sign-in screen and
// says so; nothing here invents an account.
const admin = 'https://admin.kitcommerce.store/'
const demoEmail = import.meta.env.PUBLIC_DEMO_EMAIL ?? ''
const demoPassword = import.meta.env.PUBLIC_DEMO_PASSWORD ?? ''
const demo = demoEmail && demoPassword ? `${admin}#email=${encodeURIComponent(demoEmail)}&password=${encodeURIComponent(demoPassword)}` : ''
const adminHref = demo || admin
const adminLabel = demo ? 'Live demo' : 'Open admin'

const graph = [
  { '@type': 'SoftwareApplication', '@id': abs('/gocommerce/#app'), name: 'GoCommerce', url: abs('/gocommerce/'), applicationCategory: ['DeveloperApplication', 'BusinessApplication'], applicationSubCategory: 'Headless ecommerce backend', operatingSystem: 'Cross-platform', runtimePlatform: 'Go 1.27', softwareRequirements: 'Docker, or Go 1.27 and PostgreSQL', license: 'https://opensource.org/licenses/MIT', isAccessibleForFree: true, description: 'A headless open-source ecommerce backend built with Go, with a Svelte admin compiled into the same binary. Catalog, carts, checkout, orders, payments, inventory and fulfillment over a documented REST API.', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' } },
  { '@type': 'SoftwareApplication', '@id': abs('/svelte-commerce/#app'), name: 'Svelte Commerce', url: abs('/svelte-commerce/'), applicationCategory: ['DeveloperApplication', 'BusinessApplication'], applicationSubCategory: 'Headless ecommerce storefront', operatingSystem: 'Cross-platform', runtimePlatform: 'SvelteKit', license: 'https://opensource.org/licenses/MIT', isAccessibleForFree: true, description: 'A headless open-source ecommerce storefront built with SvelteKit, running against 26 commerce backends through connector packages.', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' } },
]

const faq = [
  { q: 'What is GoCommerce?', a: 'GoCommerce is an open-source, headless ecommerce backend built with Go and PostgreSQL, with a Svelte-based admin compiled into the same binary. It serves 342 documented operations over REST.' },
  { q: 'What is Svelte Commerce?', a: 'Svelte Commerce is an open-source headless ecommerce storefront built with Svelte and SvelteKit. It reaches a commerce backend through a connector package, and 26 connectors exist today.' },
  { q: 'Is KitCommerce a product?', a: 'No. kitcommerce.store is the website presenting GoCommerce and Svelte Commerce. They are independent projects, and there is nothing called KitCommerce to install.' },
  { q: 'Can I self-host them?', a: 'Yes. Both projects are MIT licensed and designed to run on your own infrastructure: GoCommerce is one binary and one PostgreSQL, Svelte Commerce is a Node server. The compose file on this site runs the backend, its admin and a proxy on port 80 in one command.' },
  { q: 'Is there a platform fee?', a: 'No. No fee is charged for running the software and there is no hosted tier to graduate to. Your own servers, domains and third-party services still cost what they cost — the software is free, hosting is not.' },
  { q: 'Can either project be used independently?', a: 'Yes, and that is the default. GoCommerce serves any client that speaks HTTP, so any storefront framework can drive it. Svelte Commerce runs against 26 commerce backends including Medusa, Vendure, Shopify, Saleor and WooCommerce. Neither requires the other.' },
  { q: 'Can GoCommerce and Svelte Commerce work together?', a: 'Not with an installable package yet. The direct connector between them is in development and unpublished, so pairing them today means writing that client yourself against the documented GoCommerce API. The connector page tracks exactly what exists.' },
  { q: 'How do I get started?', a: 'Download docker-compose.yml and env.example from this site, set your secrets in .env, then run docker compose up -d. The admin answers on http://localhost/, the OpenAPI docs on /docs and the catalogue on /api/products. Everything deeper — your own PostgreSQL, modules, the storefront profile — is in the GoCommerce README.' },
]

// Code blocks carry braces, which Astro would read as expressions; they are
// strings here and rendered with set:html.
const composeCmd = `curl -O https://kitcommerce.store/docker-compose.yml
curl -o .env https://kitcommerce.store/env.example
<span class="cm"># edit .env — it refuses to start on placeholder secrets</span>
docker compose up -d`
const termOut = `<span data-line style="--i:0"><span class="tp">$</span> docker compose up -d</span>
<span data-line style="--i:1"> <span class="tok">✔</span> Container postgres-1    <span class="tdim">Healthy</span></span>
<span data-line style="--i:2"> <span class="tok">✔</span> Container gocommerce-1  <span class="tdim">Started</span></span>
<span data-line style="--i:3"> <span class="tok">✔</span> Container web-1         <span class="tdim">Started</span></span>
<span data-line style="--i:4"> </span>
<span data-line style="--i:5"><span class="tp">$</span> curl -s -o /dev/null -w <span class="tstr">"%{http_code}"</span> localhost</span>
<span data-line style="--i:6"><span class="tok">200</span><span class="term-caret"></span></span>`

const stack = [
  { src: '/assets/go.svg', name: 'Go' },
  { src: '/assets/svelte.svg', name: 'Svelte' },
  { src: '/assets/postgresql.svg', name: 'PostgreSQL' },
  { src: '/assets/brands/meilisearch.svg', name: 'Meilisearch' },
  { src: '/assets/docker.svg', name: 'Docker' },
]

// Admin screens, in the order a merchant meets them. Every file exists in
// light and dark; the dashboard is eager because it is the default tab.
const screens = [
  ['dashboard', 'Dashboard', 'i-server', 'The GoCommerce dashboard: net sales, order and customer counts, a daily sales chart and a best-sellers table.'],
  ['products', 'Products', 'i-package', 'The products list showing sixty-four products with status, variant count, price, available stock and last-updated time.'],
  ['orders', 'Orders', 'i-bag', 'The orders list showing two hundred and sixty orders with order number, customer, fulfillment status, payment status, item count and total.'],
  ['inventory', 'Inventory', 'i-warehouse', 'The inventory screen showing stock on hand for each SKU across several warehouse locations.'],
  ['payments', 'Payments', 'i-card', 'The payments screen listing payment providers and their configuration state.'],
  ['shipping', 'Shipping', 'i-truck', 'The shipping screen listing carriers and fulfillment providers.'],
  ['integrations', 'Plugins', 'i-plug', 'The plugins screen listing installed modules and their settings.'],
]

// The strip shows a few marks; the number is the point. All are modules
// under ext/ in the GoCommerce repository, none is an endorsement.
const strip = [['Stripe', 'stripe'], ['Razorpay', 'razorpay'], ['Adyen', 'adyen'], ['Shiprocket'], ['Delhivery'], ['Twilio', 'twilio'], ['SendGrid', 'sendgrid'], ['Meilisearch', 'meilisearch']]

const solutions = [
  { id: 'sol-marketplace', href: '/solutions/marketplace/', icon: 'i-users', title: 'Multi-vendor marketplace', cta: 'Explore marketplace →', points: ['Vendor accounts', 'Vendor offers', 'Moderation states', 'Commission recorded per vendor'] },
  { id: 'sol-b2b', href: '/solutions/b2b/', icon: 'i-tag', title: 'B2B commerce', cta: 'Explore B2B →', points: ['Customer groups', 'Price lists', 'Quantity breaks', 'Scoped API keys'] },
  { id: 'sol-d2c', href: '/solutions/d2c/', icon: 'i-bag', title: 'Direct-to-consumer', cta: 'Explore D2C →', points: ['The default store', 'Cash on delivery built in', 'Manual fulfillment built in', 'Svelte Commerce in front'] },
  { id: 'sol-channels', href: '/solutions/multi-store/', icon: 'i-store', title: 'Multi-store', cta: 'Explore multi-store →', points: ['Channels', 'Per-channel publishing', 'Per-channel price lists', 'One default channel'] },
]
const ext = { target: '_blank', rel: 'noopener noreferrer' }
---
<Base
  title="Open Source Enterprise Ecommerce Platform | GoCommerce & Svelte Commerce"
  description="Fast, open-source ecommerce you host yourself. GoCommerce compiles to one Go binary with one dependency; Svelte Commerce renders on the server. MIT licensed, no platform fees, one Docker command to run."
  path={path}
  ogTitle="Open source enterprise ecommerce platform"
  ogDescription="GoCommerce for backend and admin. Svelte Commerce for the storefront. One compiled binary, one dependency, MIT, no platform fees."
  graph={graph}
  faq={faq}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/admin/dashboard-light.webp" media="(prefers-color-scheme: light)">
  </Fragment>

  {/* ══════════════════════════════════════════════ 1 — hero */}
  <section class="hero-ledger wrap">
    <p class="kicker">Open Source</p>
    <h1>Fast ecommerce.<br>Yours to host.</h1>

    {/* The numbers, each attributed. Stars belong to Svelte Commerce and say
        so; GitHub publishes no download count for a repository without
        releases, so the second figure is forks, which it does. */}
    <ul class="hero-stats" aria-label="By the numbers">
      <li><svg aria-hidden="true"><use href="#i-git"/></svg><b data-gh="sv-stars">{n(sv.stars)}</b><span>GitHub stars, Svelte Commerce</span></li>
      <li><svg aria-hidden="true"><use href="#i-source"/></svg><b data-gh="sv-forks">{n(sv.forks)}</b><span>forks on GitHub</span></li>
      <li><svg aria-hidden="true"><use href="#i-plug"/></svg><b>26</b><span>commerce backends connected</span></li>
    </ul>

    <p class="lede">
      Open source, and built to be quick: a backend that runs as one compiled
      process on one database, and a storefront that sends finished HTML
      instead of a bundle to boot. MIT licensed, hosted by you, no platform
      fees — up on your own server with a single command.
    </p>

    <div class="actions hero-actions">
      <a class="button" href="#one-command" data-ev="quickstart_click">Deploy in minutes</a>
      <a class="button secondary" href={adminHref} {...ext} data-ev="live_admin_click">{adminLabel}</a>
      <a class="button secondary" href="https://github.com/itswadesh/gocommerce#readme" {...ext}>Documentation</a>
    </div>

    <ul class="stack-row" aria-label="Built with">
      {stack.map((s) => <li><img src={s.src} width="26" height="26" alt="" loading="lazy"><span>{s.name}</span></li>)}
    </ul>

    {/* ═══════════════════════════════════ 2 — the two projects */}
    <div class="plate">
      <p class="plate-head">Two projects <span>Both MIT licensed. Either works without the other.</span></p>

      <div class="part part-engine">
        <p class="part-id">itswadesh/gocommerce</p>
        <div>
          <p class="part-name"><a href="/gocommerce/" data-ev="gocommerce_explore">GoCommerce</a></p>
          <p class="part-role">Headless Go backend + Svelte admin. One binary, one dependency, PostgreSQL.</p>
        </div>
        <ul class="part-figures">
          <li><b>44</b> modules</li>
          <li><b>342</b> API operations</li>
          <li><b>1,036</b> tests</li>
          <li><b>61</b> admin screens</li>
        </ul>
        <div class="part-cta actions">
          <a class="button" href="/gocommerce/" data-ev="gocommerce_explore">Explore GoCommerce</a>
          <a class="button secondary" href={adminHref} {...ext} data-ev="live_admin_click">{adminLabel}</a>
          <a class="button secondary" href="https://github.com/itswadesh/gocommerce" {...ext} data-ev="github_gocommerce_click">GitHub</a>
        </div>
      </div>

      <div class="part part-store">
        <p class="part-id">itswadesh/svelte-commerce</p>
        <div>
          <p class="part-name"><a href="/svelte-commerce/" data-ev="sveltecommerce_explore">Svelte Commerce</a></p>
          <p class="part-role">Headless Svelte/SvelteKit storefront. Server-rendered, 26 backends.</p>
        </div>
        <ul class="part-figures">
          <li><b>26</b> backends</li>
          <li><b>43</b> service surface</li>
          <li><b data-gh="sv-stars">{n(sv.stars)}</b> stars</li>
          <li><b data-gh="sv-forks">{n(sv.forks)}</b> forks</li>
        </ul>
        <div class="part-cta actions">
          <a class="button" href="/svelte-commerce/" data-ev="sveltecommerce_explore">Explore Svelte Commerce</a>
          <a class="button secondary" href="https://github.com/itswadesh/svelte-commerce" {...ext} data-ev="github_sveltecommerce_click">GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <section class="hero-shots" aria-label="The software">
    <div class="wrap hero-shots-grid">
      <figure class="dev-desktop">
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="/assets/admin/dashboard-dark.webp">
          <img src="/assets/admin/dashboard-light.webp" width="1440" height="900" alt="The GoCommerce admin dashboard: net sales for the last thirty days, order, product and customer counts, a daily sales chart and a best-sellers table." decoding="async" fetchpriority="high">
        </picture>
        <figcaption><span class="shot-mark shot-go"></span><b>GoCommerce</b> <span class="role">Backend + Admin</span></figcaption>
      </figure>
      <figure class="dev-phone">
        <img src="/assets/admin/storefront-mobile.webp" width="780" height="1688" alt="The Arialshop storefront on a phone: category tiles, a jewellery hero with a shop call to action, and a bottom navigation bar." decoding="async">
        <figcaption><span class="shot-mark shot-sv"></span><b>Svelte Commerce</b> <span class="role">Storefront</span></figcaption>
      </figure>
    </div>
  </section>

  {/* Seven facts, each linking to the section that substantiates it. */}
  <section class="proofstrip proofstrip-12" aria-label="At a glance">
    <ul class="wrap proofstrip-row">
      <li><a href="#ownership"><svg aria-hidden="true"><use href="#i-source"/></svg>Open source</a></li>
      <li><a href="#ownership"><svg aria-hidden="true"><use href="#i-check"/></svg>MIT licensed</a></li>
      <li><a href="#headless"><svg aria-hidden="true"><use href="#i-plug"/></svg>Headless</a></li>
      <li><a href="#headless"><svg aria-hidden="true"><use href="#i-braces"/></svg>OpenAPI</a></li>
      <li><a href="#ownership"><svg aria-hidden="true"><use href="#i-server"/></svg>Self-hosted</a></li>
      <li><a href="#one-command"><svg aria-hidden="true"><use href="#i-terminal"/></svg>1-command deploy</a></li>
      <li><a href="#headless"><svg aria-hidden="true"><use href="#i-git"/></svg>Detachable storefront</a></li>
    </ul>
  </section>

  {/* ══════════════════════════════════════ 3 — one command */}
  <section id="one-command" class="section onecmd-section" aria-labelledby="onecmd-title">
    <div class="wrap">
      <h2 id="onecmd-title">Start on your own server in minutes</h2>
      <p class="section-lede">
        Three services, one command. This compose file is served from this
        domain and was run end to end before it was published here.
      </p>

      <div class="onecmd-grid">
        <div class="code-block">
          <div class="code-head">
            <p><svg class="ic" aria-hidden="true"><use href="#i-terminal"/></svg>Get it and run it</p>
            <button class="copy" data-copy="code-compose-run" data-ev="docker_compose_copy">Copy commands</button>
          </div>
          <pre id="code-compose-run"><code set:html={composeCmd} /></pre>
          <p class="code-note"><a href="/docker-compose.yml">docker-compose.yml</a> · <a href="/env.example">env.example</a></p>
        </div>

        <div class="terminal" role="img" aria-label="Terminal output: postgres, gocommerce and web containers started, then a 200 from localhost.">
          <p class="term-bar"><span></span><span></span><span></span></p>
          <pre class="term"><code set:html={termOut} /></pre>
        </div>
      </div>

      <h3 class="sub">After one command</h3>
      <ul class="outcome">
        <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>PostgreSQL</b><span>the database GoCommerce owns</span></li>
        <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>Commerce API</b><span>342 documented operations</span></li>
        <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>Admin panel</b><span>compiled into the same binary</span></li>
        <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>Reverse proxy</b><span>Caddy, so it answers on port 80</span></li>
      </ul>

      <div class="urls">
        <div class="url"><p class="url-what">Admin</p><p class="url-where"><code>http://localhost/</code></p><p class="url-note">Sign in with the email and password from your <code>.env</code>.</p></div>
        <div class="url"><p class="url-what">API documentation</p><p class="url-where"><code>http://localhost/docs</code></p><p class="url-note">The OpenAPI contract this build actually serves.</p></div>
        <div class="url"><p class="url-what">Catalogue</p><p class="url-where"><code>http://localhost/api/products</code></p><p class="url-note">Public and unauthenticated — the route a storefront calls.</p></div>
      </div>

      <p class="fineprint">
        <b>Svelte Commerce is behind a profile:</b> <code>docker compose --profile storefront up -d</code>
        adds it on port 3000. It renders, but cannot read from GoCommerce until the
        connector ships, so it is not in the default set —
        <a href="/gocommerce-svelte-commerce-connector/">see the connector status</a>.
        GoCommerce builds from source on first run, because no image is published yet.
      </p>
    </div>
  </section>

  {/* ═══════════════════════════════ 4 — see the software: admin */}
  <section id="live-admin" class="section admin-section" aria-labelledby="live-admin-title">
    <div class="wrap">
      <h2 id="live-admin-title">See the admin before you install</h2>
      {demo ? (
        <p class="section-lede">
          A GoCommerce instance runs at <code>admin.kitcommerce.store</code> with
          a read-only demo account. The link opens the sign-in screen with the
          demo credentials filled in — press Sign in and look around.
        </p>
      ) : (
        <p class="section-lede">
          A GoCommerce instance runs at <code>admin.kitcommerce.store</code>. It
          opens a sign-in screen — there is no demo account yet — so the
          screenshots are the preview.
        </p>
      )}

      <div class="actions">
        <a class="button secondary" href={adminHref} {...ext} data-ev="live_admin_click">{demo ? 'Open live demo' : 'Open admin sign-in'}</a>
        <a class="button secondary" href="/gocommerce/#admin" data-ev="gocommerce_explore">Every screen, explained</a>
      </div>

      <div class="tabs" role="tablist" aria-label="Admin screens">
        {screens.map(([key, label, icon], i) => (
          <button role="tab" id={`tab-${key}`} aria-controls={`panel-${key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : -1}><svg class="ic" aria-hidden="true"><use href={`#${icon}`}/></svg>{label}</button>
        ))}
      </div>

      {screens.map(([key, , , alt], i) => (
        <div class="panel" role="tabpanel" id={`panel-${key}`} aria-labelledby={`tab-${key}`} hidden={i !== 0}>
          <div class="stage"><picture><source media="(prefers-color-scheme: dark)" srcset={`/assets/admin/${key}-dark.webp`}><img src={`/assets/admin/${key}-light.webp`} width="1440" height="900" alt={alt} loading={i === 0 ? undefined : 'lazy'} decoding="async"></picture></div>
        </div>
      ))}

      <p class="fineprint">Screenshots from a seeded instance: 64 products, 260 orders across 150 days. Every screen is one of the 61 in the admin.</p>
    </div>
  </section>

  {/* ═══════════════════════════ 4 — see the software: a real store */}
  <section id="live-stores" class="section wrap" aria-labelledby="stores-title">
    <h2 id="stores-title">See it running in the real world</h2>
    <div class="store-card">
      <div class="store-shots">
        <img class="store-desk" src="/assets/admin/storefront-home.webp" width="1440" height="900" alt="The Arialshop desktop storefront: a jewellery hero image with a shop call to action, category navigation and a strip of store guarantees." loading="lazy" decoding="async">
        <img class="store-phone" src="/assets/admin/storefront-mobile.webp" width="780" height="1688" alt="The Arialshop storefront on a phone, showing category tiles and a jewellery hero banner." loading="lazy" decoding="async">
      </div>
      <div class="store-meta">
        <h3>Arialshop</h3>
        <p class="store-domain">arialshop.com</p>
        <p>A real production jewellery storefront running on Svelte Commerce — lab-grown diamond rings, with variants, sizing and checkout.</p>
        <a class="button secondary" href="https://arialshop.com" {...ext} data-ev="live_store_click">Visit store</a>
      </div>
    </div>
  </section>

  {/* ══════════════════════════════════ 5 — built for real operations */}
  <section id="operations" class="section wrap" aria-labelledby="ops-title">
    <h2 id="ops-title">Built for real operations</h2>
    <p class="section-lede">Built from years of real ecommerce workflows — not as a minimal demo stack.</p>
    <ul class="evidence">
      <li><svg aria-hidden="true"><use href="#i-shield"/></svg><b>52 granular rights</b><span>Read and write gated separately, per resource, for the admin and the API alike.</span></li>
      <li><svg aria-hidden="true"><use href="#i-braces"/></svg><b>Scoped API keys</b><span>A key carries a role, a prefix for the log line, a last-used time and a revocation.</span></li>
      <li><svg aria-hidden="true"><use href="#i-bag"/></svg><b>Separate payment and fulfillment state</b><span>Two facts about an order, tracked as two facts.</span></li>
      <li><svg aria-hidden="true"><use href="#i-warehouse"/></svg><b>Multi-location inventory</b><span>Stock on hand per location, reserved separately from available.</span></li>
      <li><svg aria-hidden="true"><use href="#i-card"/></svg><b>9 payment modules</b><span>Money as integer minor units, never a float.</span></li>
      <li><svg aria-hidden="true"><use href="#i-return"/></svg><b>Idempotent writes</b><span>Repeat a checkout request safely; the order importer fires no events and moves no stock.</span></li>
    </ul>
  </section>

  <section id="capabilities" class="section wrap" aria-labelledby="cap-title">
    <h2 id="cap-title">Core capabilities</h2>
    <ul class="capwall">
      <li><svg aria-hidden="true"><use href="#i-package"/></svg>Products</li>
      <li><svg aria-hidden="true"><use href="#i-tag"/></svg>Variants</li>
      <li><svg aria-hidden="true"><use href="#i-bag"/></svg>Orders</li>
      <li><svg aria-hidden="true"><use href="#i-users"/></svg>Customers</li>
      <li><svg aria-hidden="true"><use href="#i-warehouse"/></svg>Inventory</li>
      <li><svg aria-hidden="true"><use href="#i-card"/></svg>Payments</li>
      <li><svg aria-hidden="true"><use href="#i-truck"/></svg>Shipping</li>
      <li><svg aria-hidden="true"><use href="#i-return"/></svg>Returns</li>
      <li><svg aria-hidden="true"><use href="#i-search"/></svg>Search</li>
      <li><svg aria-hidden="true"><use href="#i-coin"/></svg>Discounts</li>
      <li><svg aria-hidden="true"><use href="#i-store"/></svg>Channels</li>
      <li><svg aria-hidden="true"><use href="#i-shield"/></svg>Auth</li>
      <li><svg aria-hidden="true"><use href="#i-braces"/></svg>REST API</li>
      <li><svg aria-hidden="true"><use href="#i-webhook"/></svg>Webhooks</li>
      <li><svg aria-hidden="true"><use href="#i-db"/></svg>Migrations</li>
      <li><svg aria-hidden="true"><use href="#i-server"/></svg>Admin</li>
    </ul>
  </section>

  <section id="integrations" class="intstrip-section" aria-labelledby="int-title">
    <div class="wrap">
