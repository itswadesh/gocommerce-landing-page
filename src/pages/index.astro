---
/**
 * The homepage follows litekart.in's order, which the owner asked for: see
 * the product, see the proof, see why it is built the way it is, see what a
 * merchant runs, what a developer gets, the whole feature list, the stores
 * already live, and how to start. Every number on it is one this site can
 * check — the audit and performance claims on that page are replaced by
 * measured Lighthouse scores on /live-projects/, and by nothing where there
 * is nothing to measure.
 *
 * The composition is still the reference the site was redesigned against: a
 * centred hero over one large product card, sections headed by an eyebrow and
 * a serif title with the lede alongside, hairline cards, one dark closing band.
 */
import Base from '../layouts/Base.astro'
import Faq from '../components/Faq.astro'
import ProductShot from '../components/ProductShot.astro'
import Illustration from '../components/Illustration.astro'
import demoAccount from '../data/demo.json'
import live from '../data/live-projects.json'
import themes from '../data/themes.json'

const path = '/'
const site = Astro.site!
const abs = (p: string) => new URL(p, site).href

// Repository figures are fetched at build time so a deploy carries the
// current count; the fallback is the last value measured by hand. app.js
// refreshes them again in the browser if GitHub answers.
async function repoStats(repo: string, fallback: { stars: number; forks: number }) {
  try {
    const ctrl = new AbortController()
    const timer = setTimeout(() => ctrl.abort(), 5000)
    const r = await fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'kitcommerce.store build' }, signal: ctrl.signal })
    clearTimeout(timer)
    if (!r.ok) return fallback
    const j = await r.json()
    return { stars: typeof j.stargazers_count === 'number' ? j.stargazers_count : fallback.stars, forks: typeof j.forks_count === 'number' ? j.forks_count : fallback.forks }
  } catch { return fallback }
}
const sv = await repoStats('itswadesh/svelte-commerce', { stars: 1815, forks: 336 })
const n = (x: number) => x.toLocaleString('en')

// The live demo. The demo account lives in src/data/demo.json — public by
// design, since it is printed on this page — and the build environment can
// override or blank it. The admin link carries the credentials in the URL
// fragment, never sent to the server, so never in an access log or a
// Referer, and the admin's sign-in form prefills from it. With no account,
// the link is the plain sign-in screen and says so.
const admin = 'https://admin.kitcommerce.store/'
const demoEmail = import.meta.env.PUBLIC_DEMO_EMAIL ?? demoAccount.email ?? ''
const demoPassword = import.meta.env.PUBLIC_DEMO_PASSWORD ?? demoAccount.password ?? ''
const demo = demoEmail && demoPassword ? `${admin}#email=${encodeURIComponent(demoEmail)}&password=${encodeURIComponent(demoPassword)}` : ''
const adminHref = demo || admin
const adminLabel = demo ? 'Live demo' : 'Open admin'

const graph = [
  { '@type': 'SoftwareApplication', '@id': abs('/gocommerce/#app'), name: 'GoCommerce', url: abs('/gocommerce/'), applicationCategory: 'DeveloperApplication', applicationSubCategory: 'Headless ecommerce backend', operatingSystem: 'Cross-platform', runtimePlatform: 'Go 1.27', softwareRequirements: 'Docker, or Go 1.27 and PostgreSQL', license: 'https://opensource.org/licenses/MIT', isAccessibleForFree: true, description: 'A headless open-source ecommerce backend built with Go, with a Svelte admin compiled into the same binary. Catalog, carts, checkout, orders, payments, inventory and fulfillment over a documented REST API.', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' } },
  { '@type': 'SoftwareApplication', '@id': abs('/svelte-commerce/#app'), name: 'Svelte Commerce', url: abs('/svelte-commerce/'), applicationCategory: 'DeveloperApplication', applicationSubCategory: 'Headless ecommerce storefront', operatingSystem: 'Cross-platform', runtimePlatform: 'SvelteKit', license: 'https://opensource.org/licenses/MIT', isAccessibleForFree: true, description: 'A headless open-source ecommerce storefront built with SvelteKit, running against 26 commerce backends through connector packages.', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' } },
]

const faq = [
  { q: 'What is GoCommerce?', a: 'GoCommerce is an open-source, headless ecommerce backend built with Go and PostgreSQL, with a Svelte-based admin compiled into the same binary. It serves 342 documented operations over REST.' },
  { q: 'What is Svelte Commerce?', a: 'Svelte Commerce is an open-source headless ecommerce storefront built with Svelte and SvelteKit. It reaches a commerce backend through a connector package, and 26 connectors exist today.' },
  { q: 'Is KitCommerce a product?', a: 'No. kitcommerce.store is the website presenting GoCommerce and Svelte Commerce. They are independent projects, and there is nothing called KitCommerce to install.' },
  { q: 'Can I self-host them?', a: 'Yes. Both projects are MIT licensed and designed to run on your own infrastructure: GoCommerce is one binary and one PostgreSQL, Svelte Commerce is a Node server. The compose file on this site runs the backend, its admin and a proxy on port 80 in one command.' },
  { q: 'Is there a platform fee or a paid plan?', a: 'No. There is one plan and it is free, for life: no fee on your orders and no hosted tier to graduate to. Your own servers, domains and third-party services still cost what they cost — the software is free, hosting is not.' },
  { q: 'Can I white-label it?', a: 'Yes. Both projects are MIT, so you can rename them, restyle the storefront and the admin, and ship them under your own brand for yourself or for clients. Keeping the copyright notice in the source is the only condition.' },
  { q: 'Can GoCommerce and Svelte Commerce work together?', a: 'Through an early connector: @misiki/gocommerce-connector 0.1.0 lets Svelte Commerce browse a GoCommerce catalogue, fill a cart, check out and look up an order. Customer accounts and a search index are not covered yet. Either project also works alone: GoCommerce with any HTTP client, Svelte Commerce with 26 other backends.' },
  { q: 'How do I get started?', a: 'Download docker-compose.yml and env.example from this site, set your secrets in .env, then run docker compose up -d. The admin answers on http://localhost/, the OpenAPI docs on /docs and the catalogue on /api/products. Everything deeper — your own PostgreSQL, modules, the storefront profile — is in the GoCommerce README.' },
]

// Code blocks carry braces, which Astro would read as expressions; they are
// strings here and rendered with set:html.
const composeCmd = `curl -O https://kitcommerce.store/docker-compose.yml
curl -o .env https://kitcommerce.store/env.example
<span class="cm"># edit .env — it will not start while a required secret is unset</span>
docker compose up -d`
const termOut = `<span data-line style="--i:0"><span class="tp">$</span> docker compose up -d</span>
<span data-line style="--i:1"> <span class="tok">✔</span> Container postgres-1    <span class="tdim">Healthy</span></span>
<span data-line style="--i:2"> <span class="tok">✔</span> Container gocommerce-1  <span class="tdim">Started</span></span>
<span data-line style="--i:3"> <span class="tok">✔</span> Container web-1         <span class="tdim">Started</span></span>
<span data-line style="--i:4"> </span>
<span data-line style="--i:5"><span class="tp">$</span> curl -s -o /dev/null -w <span class="tstr">"%{http_code}"</span> localhost</span>
<span data-line style="--i:6"><span class="tok">200</span><span class="term-caret"></span></span>`

// The walkthrough from the GoCommerce README, pointed at the one-command stack
// (Caddy on port 80). A backslash before a newline would be swallowed by the
// template literal, hence the doubled ones.
const integrateCode = `<span class="cm"># 1 — the catalogue: public, no key</span>
curl localhost/api/products

<span class="cm"># 2 — open a cart and add a variant</span>
CART=$(curl -sX POST localhost/api/carts | jq -r .data.id)
curl -X POST localhost/api/carts/$CART/line-items \\
  -d <span class="s">'{"variant_id":2,"quantity":2}'</span>

<span class="cm"># 3 — check out; the same key again returns the same order</span>
curl -X POST localhost/api/checkout/cod -H <span class="s">'Idempotency-Key: demo-1'</span> \\
  -d <span class="s">'{"cart_id":"'</span>$CART<span class="s">'","email":"buyer@example.com",
       "address":{"line1":"1 High St","city":"Town",
                  "postal_code":"12345","country":"US"}}'</span>`

const stack = [
  { src: '/assets/go.svg', name: 'Go' },
  { src: '/assets/svelte.svg', name: 'Svelte' },
  { src: '/assets/postgresql.svg', name: 'PostgreSQL' },
  { src: '/assets/brands/meilisearch.svg', name: 'Meilisearch' },
  { src: '/assets/docker.svg', name: 'Docker' },
]

// Admin screens, in the order a merchant meets them. Each tab shows a focused,
// lossless crop of the real capture (scripts/crop-product-screenshots.mjs) in
// a browser frame, with a narrower crop for phones and a link to the full
// screenshot. Dimensions are the crop boxes; the dashboard is eager because
// it is the default tab.
const screens = [
  { key: 'dashboard', label: 'Dashboard', icon: 'i-server', w: 1180, h: 620, mw: 282, mh: 92, alt: 'GoCommerce dashboard detail from the seeded store: revenue, orders, products and customers, recent orders and the daily sales chart.', mobileAlt: 'Revenue detail from the seeded store.', caption: 'Revenue, recent orders and daily sales.' },
  { key: 'products', label: 'Products', icon: 'i-package', w: 1180, h: 436, mw: 370, mh: 436, alt: 'The GoCommerce products list: names, status, variant count, price and available stock.', mobileAlt: 'Product names and slugs.', caption: 'Names, status, variants, prices and available stock.' },
  { key: 'orders', label: 'Orders', icon: 'i-bag', w: 1180, h: 410, mw: 310, mh: 410, alt: 'The GoCommerce orders list: order number, customer, fulfillment status, payment status and total.', mobileAlt: 'Fulfillment and payment states, side by side.', caption: 'Fulfillment and payment are separate states.' },
  { key: 'inventory', label: 'Inventory', icon: 'i-warehouse', w: 1180, h: 423, mw: 354, mh: 423, alt: 'The GoCommerce inventory screen: on-hand, reserved and available stock per SKU across locations.', mobileAlt: 'On-hand, reserved and available stock.', caption: 'On-hand, reserved and available stock per SKU.' },
  { key: 'payments', label: 'Payments', icon: 'i-card', w: 1000, h: 260, mw: 386, mh: 108, alt: 'The payment methods screen of a store with no gateway module installed: cash on delivery, built in and active.', mobileAlt: 'Cash on delivery, built in.', caption: 'Cash on delivery is built in; gateways are modules.' },
  { key: 'shipping', label: 'Shipping', icon: 'i-truck', w: 1180, h: 560, mw: 360, mh: 500, alt: 'The shipping and delivery screen: one zone with USPS and FedEx rates by basket value.', mobileAlt: 'Rates by basket value.', caption: 'Zones and rates by basket value; the most specific zone wins.' },
  { key: 'integrations', label: 'Plugins', icon: 'i-plug', w: 1180, h: 620, mw: 386, mh: 466, alt: 'The plugins screen: storefront and marketing features already in the binary, switched on or off per store.', mobileAlt: 'Storefront plugins, on or off.', caption: 'Seventeen switches already in the binary; a storefront reads the enabled ones.' },
]

// The strip shows a few marks; the number is the point. All are modules
// under ext/ in the GoCommerce repository, none is an endorsement.
const strip = [['Stripe', 'stripe'], ['Razorpay', 'razorpay'], ['Adyen', 'adyen'], ['Shiprocket'], ['Delhivery'], ['Twilio', 'twilio'], ['SendGrid', 'sendgrid'], ['Meilisearch', 'meilisearch']]

const solutions = [
  { id: 'sol-marketplace', href: '/solutions/marketplace/', icon: 'i-users', tint: 'tint-sky', title: 'Multi-vendor marketplace', cta: 'Explore marketplace →', points: ['Vendor accounts', 'Vendor offers', 'Moderation states', 'Commission recorded per vendor'] },
  { id: 'sol-b2b', href: '/solutions/b2b/', icon: 'i-tag', tint: 'tint-mint', title: 'B2B commerce', cta: 'Explore B2B →', points: ['Customer groups', 'Price lists', 'Quantity breaks', 'Scoped API keys'] },
  { id: 'sol-d2c', href: '/solutions/d2c/', icon: 'i-bag', tint: 'tint-peach', title: 'Direct-to-consumer', cta: 'Explore D2C →', points: ['The default store', 'Cash on delivery built in', 'Manual fulfillment built in', 'Svelte Commerce in front'] },
  { id: 'sol-channels', href: '/solutions/multi-store/', icon: 'i-store', tint: 'tint-lilac', title: 'Multi-store', cta: 'Explore multi-store →', points: ['Channels', 'Per-channel publishing', 'Per-channel price lists', 'One default channel'] },
]

// The whole feature list, grouped the way litekart.in groups its own. Every
// line is a thing in the GoCommerce code or a module in ext/, checked tile by
// tile for /features/ — nothing here is a roadmap item.
const featureGroups = [
  { name: 'Catalogue', items: ['Products and variants', 'Attributes from Shopify’s taxonomy', 'Categories and collections', 'Custom metadata on 15 tables'] },
  { name: 'Search and discovery', items: ['Filtering and sorting in the engine', 'Meilisearch module', 'Sitemaps and IndexNow modules', 'Google Merchant and Meta feeds'] },
  { name: 'Cart and checkout', items: ['Guest carts and checkout', 'Idempotent, never-repricing checkout', 'Discount codes', 'Abandoned-cart recovery'] },
  { name: 'Orders and fulfilment', items: ['Order timeline and edits', 'Shipping in parcels, 12 carrier options', 'Returns with per-line restock', 'Invoices, picking sheets, packing slips'] },
  { name: 'Payments', items: ['Nine gateway modules', 'Cash on delivery built in', 'Refunds through the gateway', 'Payouts by payment method'] },
  { name: 'Customers and B2B', items: ['Shopper accounts (identity module)', 'Customer groups and price lists', 'Quantity breaks', 'Reviews and wishlists'] },
  { name: 'Marketplace and multi-store', items: ['Vendors, moderated, with their own logins', 'Channels with their own price lists', 'Roles and scoped API keys', 'Stock across locations'] },
  { name: 'Content and messaging', items: ['CMS pages, menus and FAQ', 'Newsletter and Klaviyo', 'Email: Resend, SendGrid', 'SMS: Twilio, MSG91'] },
  { name: 'Infrastructure', items: ['One Go binary and PostgreSQL', '342 operations in OpenAPI', 'Signed webhooks, events never lost', 'gocommerce doctor and an MCP server'] },
]

// Rendered only when a number is configured; never a placeholder.
const wa = import.meta.env.PUBLIC_WHATSAPP ?? ''
const liveCount = live.stores.length
const livePreview = live.stores.filter((s) => s.scores).slice(0, 3)
const ext = { target: '_blank', rel: 'noopener noreferrer' }
---
<Base
  title="KitCommerce — Open-Source Go & Svelte Enterprise Ecommerce"
  description="Self-hosted, white-label, open-source ecommerce: GoCommerce is one Go binary with one dependency; Svelte Commerce renders on the server. MIT, free for life."
  path={path}
  ogTitle="Open source enterprise ecommerce platform"
  ogDescription="GoCommerce for backend and admin. Svelte Commerce for the storefront. Self-hosted, white-label, MIT, free for life."
  graph={graph}
  faq={faq}
>
  <Fragment slot="head">
    {/* The hero's product card is the largest image on the page; one preload
        per scheme so the right one is discovered with the HTML. */}
    <link rel="preload" as="image" href="/assets/admin/dashboard-light.webp" media="(prefers-color-scheme: light)">
    <link rel="preload" as="image" href="/assets/admin/dashboard-dark.webp" media="(prefers-color-scheme: dark)">
  </Fragment>

  {/* ══════════════════════════════════════════════ 1 — hero */}
  <section class="hero-center wrap">
    <a class="pill" href="/pricing/">Open source · MIT licensed · Free for life <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a>
    <h1>Open-source ecommerce platform</h1>
    <p class="lede">Self-hosted, free for life, and yours to brand.</p>
    {/* Enterprise-grade, fast, scalable, tested, working, white-label — each
        word carried by the fact under it rather than asserted on its own.
        "Error free" is said the only way software can honestly say it: as
        the test suite that stands behind the API. */}
    <ul class="hero-points" aria-label="In short">
      <li><svg aria-hidden="true"><use href="#i-shield"/></svg><b>Enterprise-grade</b><span>B2B, marketplace and multi-store in one engine</span></li>
      <li><svg aria-hidden="true"><use href="#i-zap"/></svg><b>Fast by design</b><span>One compiled Go binary, server-rendered pages</span></li>
      <li><svg aria-hidden="true"><use href="#i-db"/></svg><b>Built to scale</b><span>Add servers behind a load balancer, one PostgreSQL</span></li>
      <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>Over 1,000 tests</b><span>And a documented contract for every route</span></li>
      <li><svg aria-hidden="true"><use href="#i-terminal"/></svg><b>It just works</b><span>Up on your own server with one command</span></li>
      <li><svg aria-hidden="true"><use href="#i-tag"/></svg><b>Your brand, no fees</b><span>MIT licensed, white-label, 0% of your sales</span></li>
    </ul>
    <div class="actions hero-actions">
      <a class="button" href="#one-command" data-ev="quickstart_click">Deploy in minutes</a>
      <a class="button secondary" href={adminHref} {...ext} data-ev="live_admin_click">{adminLabel}</a>
    </div>
    {/* The numbers, each attributed. Stars belong to Svelte Commerce and say
        so; GitHub publishes no download count for a repository without
        releases, so the second figure is forks, which it does. */}
    <ul class="hero-stats" aria-label="By the numbers">
      <li><b data-gh="sv-stars">{n(sv.stars)}</b><span>GitHub stars, Svelte Commerce</span></li>
      <li><b data-gh="sv-forks">{n(sv.forks)}</b><span>forks</span></li>
      <li><b>26</b><span>commerce backends connected</span></li>
    </ul>
    <p class="hero-own">Own your code. Own your infrastructure. Own your customer data.</p>

    <div class="hero-wash">
      <figure class="product-card">
        <div class="bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="url">admin.kitcommerce.store</span><span class="tag">GoCommerce admin · seeded demo data</span></div>
        <a href="/assets/admin/dashboard-light.webp" {...ext} aria-label="Open the full admin dashboard screenshot in a new tab">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset="/assets/admin/dashboard-dark.webp">
            <img src="/assets/admin/dashboard-light.webp" width="1440" height="900" alt="The GoCommerce admin dashboard: net sales for the last thirty days, order, product and customer counts, a daily sales chart and a best-sellers table." decoding="async" fetchpriority="high">
          </picture>
        </a>
      </figure>
    </div>
  </section>

  <section class="logostrip wrap" aria-labelledby="built-title">
    <p id="built-title">Built with</p>
    <ul>{stack.map((s) => <li><img src={s.src} width="24" height="24" alt="" loading="lazy"><span>{s.name}</span></li>)}</ul>
  </section>

  {/* ══════════════════════════════ 2 — see it before you deploy */}
  <section id="live-admin" class="section admin-section" aria-labelledby="live-admin-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="kicker">A look inside</p>
          <h2 id="live-admin-title">See it before you deploy it</h2>
        </div>
        {demo ? (
          <p class="section-lede">
            A GoCommerce instance runs at <code>admin.kitcommerce.store</code> as a
            public demo: the link opens the sign-in screen with the demo account
            filled in — press Login and look around. It is a real store you can
            change; every email address and phone number in it is masked, and
            the team, its keys and its roles are frozen.
          </p>
        ) : (
          <p class="section-lede">
            A GoCommerce instance runs at <code>admin.kitcommerce.store</code>. It
            opens a sign-in screen — there is no demo account yet — so the
            screenshots are the preview.
          </p>
        )}
      </div>

      <div class="tabs" role="tablist" aria-label="Admin screens">
        {screens.map((s, i) => (
          <button role="tab" id={`tab-${s.key}`} aria-controls={`panel-${s.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : -1}><svg class="ic" aria-hidden="true"><use href={`#${s.icon}`}/></svg>{s.label}</button>
        ))}
      </div>

      {screens.map((s, i) => (
        <div class="panel" role="tabpanel" id={`panel-${s.key}`} aria-labelledby={`tab-${s.key}`} hidden={i !== 0}>
          <ProductShot name={s.key} label={`GoCommerce / ${s.label}`} alt={s.alt} mobileAlt={s.mobileAlt} caption={s.caption} width={s.w} height={s.h} mobileWidth={s.mw} mobileHeight={s.mh} eager={i === 0} />
        </div>
      ))}

      <div class="actions">
        <a class="button" href={adminHref} {...ext} data-ev="live_admin_click">{demo ? 'Open live demo' : 'Open admin sign-in'}</a>
        <a class="button secondary" href="/gocommerce/admin/" data-ev="gocommerce_explore">Every screen, captured</a>
      </div>
      <p class="fineprint">Screenshots from a seeded instance: 64 products, 260 orders across 150 days. Every screen is one of the 61 in the admin.</p>
    </div>
  </section>

  {/* ══════════════════════════════════════════ 3 — proof strip */}
  <section class="proofbar wrap" aria-label="What is in the box">
    <ul>
      <li><b>61</b><span>admin screens</span></li>
      <li><b>342</b><span>documented API operations</span></li>
      <li><b>44</b><span>modules</span></li>
      <li><b>{themes.length}</b><span>storefront themes</span></li>
      <li><b>{liveCount}</b><span>live stores</span></li>
    </ul>
  </section>

  {/* ════════════════════════════════ 4 — how it's built (illustrations) */}
  <section id="how-built" class="section wrap" aria-labelledby="how-built-title">
    <div class="sec-head">
      <div>
        <p class="kicker">Why teams pick it</p>
        <h2 id="how-built-title">Self-hosted. Scalable. Fast.</h2>
      </div>
      <p class="section-lede">Four mechanisms the GoCommerce docs describe, drawn with the names from the code. No timings or benchmark figures — none are published.</p>
    </div>
    <div class="illus-grid">
      <Illustration kind="scalable" />
      <div id="headless"><Illustration kind="headless" /></div>
      <Illustration kind="modular" />
      <Illustration kind="fast" />
    </div>
    <div class="actions">
      <a class="button secondary" href="/go-svelte-ecommerce/" data-ev="architecture_click">See the full architecture</a>
      <a class="button secondary" href="/features/development/">Developer features</a>
    </div>
  </section>

  {/* ═══════════════════════════════════════ 5 — the storefront */}
  <section id="live-stores" class="section wrap" aria-labelledby="stores-title">
    <div class="sec-head">
      <div>
        <p class="kicker">Sell</p>
        <h2 id="stores-title">A storefront buyers don’t wait for</h2>
      </div>
      <p class="section-lede">Svelte Commerce renders every page on the server, so a shopper and a crawler both receive the page itself, not a bundle to boot. {themes.length} live themes to start from; this one is a jewellery business selling on it today.</p>
    </div>
    <div class="store-card real-store">
      <figure class="storefront-desktop">
        <div class="store-browser">
          <p class="store-browser-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span> arialshop.com <span>Desktop storefront</span></p>
          <a href="/assets/admin/storefront-home.webp" {...ext} aria-label="Open full Arialshop desktop screenshot in a new tab">
            <picture>
              <source media="(max-width: 600px)" srcset="/assets/admin/storefront-mobile.webp" width="780" height="1688">
              <img src="/assets/admin/focus/storefront-desktop.webp" width="1440" height="764" alt="The Arialshop desktop storefront: a jewellery hero image with a shop call to action and category navigation." loading="lazy" decoding="async">
            </picture>
          </a>
        </div>
        <figcaption>Real storefront capture · <a href="/assets/admin/storefront-home.webp" {...ext}>Full desktop screenshot ↗</a></figcaption>
      </figure>
      <div class="store-meta">
        <div><h3>Arialshop</h3><p class="store-domain">arialshop.com</p><p>A real production jewellery storefront running on Svelte Commerce — lab-grown diamond rings, with variants, sizing and checkout.</p></div>
        <a class="button secondary" href="https://arialshop.com" {...ext} data-ev="live_store_click">Visit store</a>
      </div>
    </div>
    <div class="actions">
      <a class="button secondary" href="/svelte-commerce/themes/">Browse {themes.length} themes</a>
      <a class="button secondary" href="/svelte-commerce/">Explore Svelte Commerce</a>
    </div>
  </section>

  {/* ══════════════════════════════════ 6 — run the business */}
  <section id="operations" class="section wrap" aria-labelledby="ops-title">
    <div class="sec-head">
      <div>
        <p class="kicker">Manage</p>
        <h2 id="ops-title">Run the business from one admin</h2>
      </div>
      <p class="section-lede">Orders, stock, customers, refunds and staff, from the 61-screen admin compiled into the GoCommerce binary. Each of these is a thing in the code, not an adjective.</p>
    </div>
    <ul class="evidence">
      <li><svg aria-hidden="true"><use href="#i-shield"/></svg><b>Rights, per resource</b><span>48 core rights, read and write gated separately, plus those modules add — for the admin and the API alike.</span></li>
      <li><svg aria-hidden="true"><use href="#i-braces"/></svg><b>Scoped API keys</b><span>A key carries a role, a prefix for the log line, a last-used time and a revocation.</span></li>
      <li><svg aria-hidden="true"><use href="#i-bag"/></svg><b>Order timeline and edits</b><span>Every change on the record; edit lines and stock moves with them.</span></li>
      <li><svg aria-hidden="true"><use href="#i-warehouse"/></svg><b>Multi-location inventory</b><span>Stock on hand per location, reserved separately, every movement on a ledger.</span></li>
      <li><svg aria-hidden="true"><use href="#i-card"/></svg><b>9 payment modules</b><span>Money as integer minor units, never a float.</span></li>
      <li><svg aria-hidden="true"><use href="#i-return"/></svg><b>Idempotent writes</b><span>Repeat a checkout request safely; a changed price answers 409 instead of charging.</span></li>
    </ul>
    <div class="actions">
