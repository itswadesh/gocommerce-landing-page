---
/**
 * The homepage argues with screenshots, icons and measured numbers. Positioning
 * is Speed and Open source: speed argued from the architecture — one compiled
 * binary, one dependency, a server-rendered storefront — with the missing
 * benchmarks named in a footnote rather than hidden; open source argued from
 * the licence, which needs no argument.
 */
import Base from '../layouts/Base.astro'
import Faq from '../components/Faq.astro'

const path = '/'
const site = Astro.site!
const abs = (p: string) => new URL(p, site).href

const graph = [
  { '@type': 'SoftwareApplication', '@id': abs('/gocommerce/#app'), name: 'GoCommerce', url: abs('/gocommerce/'), applicationCategory: ['DeveloperApplication', 'BusinessApplication'], applicationSubCategory: 'Headless ecommerce backend', operatingSystem: 'Cross-platform', runtimePlatform: 'Go 1.27', softwareRequirements: 'Docker, or Go 1.27 and PostgreSQL', license: 'https://opensource.org/licenses/MIT', isAccessibleForFree: true, description: 'A headless open-source ecommerce backend built with Go, with a Svelte admin compiled into the same binary. Catalog, carts, checkout, orders, payments, inventory and fulfillment over a documented REST API.', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' } },
  { '@type': 'SoftwareApplication', '@id': abs('/svelte-commerce/#app'), name: 'Svelte Commerce', url: abs('/svelte-commerce/'), applicationCategory: ['DeveloperApplication', 'BusinessApplication'], applicationSubCategory: 'Headless ecommerce storefront', operatingSystem: 'Cross-platform', runtimePlatform: 'SvelteKit', license: 'https://opensource.org/licenses/MIT', isAccessibleForFree: true, description: 'A headless open-source ecommerce storefront built with SvelteKit, running against 26 commerce backends through connector packages.', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' } },
]

const faq = [
  { q: 'What is GoCommerce?', a: 'GoCommerce is an open-source, headless ecommerce backend built with Go and PostgreSQL, with a Svelte-based admin compiled into the same binary. It serves 342 documented operations over REST.' },
  { q: 'What is Svelte Commerce?', a: 'Svelte Commerce is an open-source headless ecommerce storefront built with Svelte and SvelteKit. It reaches a commerce backend through a connector package, and 26 connectors exist today.' },
  { q: 'Is KitCommerce a product?', a: 'No. kitcommerce.store is the website presenting GoCommerce and Svelte Commerce. They are independent projects, and there is nothing called KitCommerce to install.' },
  { q: 'How fast is it?', a: 'No benchmark figures have been published, so this site does not quote one. What it can say is architectural and checkable: GoCommerce compiles to a single binary with one production dependency, serves the API and the admin from one process against one database, and loads no plugins at runtime; Svelte Commerce renders on the server so the first byte is HTML. Benchmarks are on the roadmap.' },
  { q: 'Can I self-host them, and is there a platform fee?', a: 'Yes to self-hosting, and no platform fee. Both projects are MIT licensed and designed to run on your own infrastructure. No fee is charged for running the software. Your own servers, domains and third-party services still cost money — the software is free, hosting is not.' },
  { q: 'Can I use GoCommerce without Svelte Commerce, or the other way round?', a: 'Both. GoCommerce serves any client that speaks HTTP, so any storefront framework can drive it. Svelte Commerce runs against 26 commerce backends including Medusa, Vendure, Shopify, Saleor and WooCommerce. Neither requires the other.' },
  { q: 'Can they work together today?', a: 'Not with an installable package. The direct connector between them is in development and unpublished, so pairing them currently means writing that client yourself against the documented GoCommerce API.' },
  { q: 'How quickly can I get started?', a: 'One Docker Compose command. Download docker-compose.yml and env.example from this site, set your secrets in .env, then run docker compose up -d. The first run compiles GoCommerce from source because no image is published yet; later runs are cached.' },
  { q: 'What does Docker Compose actually start?', a: 'Three services: PostgreSQL, GoCommerce — which serves both the commerce API and the admin, because the admin is compiled into the binary — and Caddy as a reverse proxy on port 80. Svelte Commerce is behind a profile, because the connector that would let it read from GoCommerce is unpublished; it starts with --profile storefront and renders, but loads no products from this stack.' },
  { q: 'Can I use my own PostgreSQL database?', a: 'Yes. GoCommerce takes a DATABASE_URL, so pointing it at a Postgres you already run means setting that variable and removing the bundled postgres service from the compose file.' },
  { q: 'Is it production ready?', a: 'They differ, and it matters. Svelte Commerce has been public for years and runs production stores — arialshop.com is one. GoCommerce is 1.0, so its API and HTTP contract are stable and breaking either takes a major version; it carries 1,036 tests and a documented contract for every route. What 1.0 does not supply is production mileage: no store is known to run it yet.' },
  { q: 'Does it work with coding agents?', a: 'The repository is written for it: AGENTS.md holds 18 architectural rules, skills/ holds 16 task guides, there is one production dependency so the graph an agent must understand is small, and 1,036 tests catch a wrong edit. The MCP module also lets an agent operate a running store through the same domain services a REST call uses.' },
  { q: 'Is there a live demo I can click around?', a: 'Not yet. A GoCommerce instance is deployed at admin.kitcommerce.store, but every endpoint requires authentication and there is no guest account, so the link opens a sign-in screen. The screenshots on this site are the honest preview until a read-only demo account exists.' },
]

// Code blocks carry braces, which Astro would read as expressions; they are
// strings here and rendered with set:html.
const composeCmd = `curl -O https://kitcommerce.store/docker-compose.yml
curl -o .env https://kitcommerce.store/env.example
<span class="cm"># edit .env — it refuses to start on placeholder secrets</span>
docker compose up -d`
const termOut = `<span data-line style="--i:0"><span class="tp">$</span> docker compose up -d</span>
<span data-line style="--i:1"> <span class="tok">✔</span> Container postgres-1    <span class="tdim">Healthy</span></span>
<span data-line style="--i:2"> <span class="tok">✔</span> Container gocommerce-1  <span class="tdim">Started</span></span>
<span data-line style="--i:3"> <span class="tok">✔</span> Container web-1         <span class="tdim">Started</span></span>
<span data-line style="--i:4"> </span>
<span data-line style="--i:5"><span class="tp">$</span> curl -s -o /dev/null -w <span class="tstr">"%{http_code}"</span> localhost</span>
<span data-line style="--i:6"><span class="tok">200</span><span class="term-caret"></span></span>`

const stack = [
  { src: '/assets/go.svg', name: 'Go' },
  { src: '/assets/svelte.svg', name: 'Svelte' },
  { src: '/assets/postgresql.svg', name: 'PostgreSQL' },
  { src: '/assets/brands/meilisearch.svg', name: 'Meilisearch' },
  { src: '/assets/docker.svg', name: 'Docker' },
]
const marquee = [...stack, { src: '/assets/typescript.svg', name: 'TypeScript' }, { src: '/assets/github.svg', name: 'GitHub' }, { src: '/assets/cloudflare.svg', name: 'Cloudflare' }]

// Integrations that have a mark get one; the rest stay as text. All are
// modules under ext/ in the GoCommerce repository, none is an endorsement.
const pay = [['Stripe', 'stripe'], ['Razorpay', 'razorpay'], ['Adyen', 'adyen'], ['Paddle', 'paddle'], ['HyperSwitch'], ['Lemon Squeezy', 'lemonsqueezy'], ['Helcim'], ['Creem'], ['RevenueCat', 'revenuecat']]
const ship = [['Shiprocket'], ['Delhivery'], ['Shippo'], ['ShipStation'], ['EasyShip'], ['Shippit'], ['USPS', 'usps'], ['India Post'], ['NimbusPost'], ['Onfleet'], ['Veeqo']]
const msg = [['Resend', 'resend'], ['SendGrid', 'sendgrid'], ['Twilio', 'twilio'], ['MSG91'], ['Klaviyo'], ['Meilisearch', 'meilisearch']]
---
<Base
  title="Fast, Open Source Ecommerce You Host Yourself | GoCommerce & Svelte Commerce"
  description="Fast, open-source ecommerce you host yourself. GoCommerce compiles to one Go binary with one dependency; Svelte Commerce renders on the server. MIT licensed, no platform fees, one Docker command to run."
  path={path}
  ogTitle="Fast, open-source ecommerce you host yourself"
  ogDescription="GoCommerce for backend and admin. Svelte Commerce for the storefront. One compiled binary, one dependency, MIT, no platform fees."
  graph={graph}
  faq={faq}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/admin/dashboard-light.webp" media="(prefers-color-scheme: light)">
  </Fragment>

  {/* ══════════════════════════════════════════════ 1 — hero */}
  <section class="hero-ledger wrap">
    <p class="kicker">Open Source</p>
    <h1>Fast ecommerce.<br>Yours to host.</h1>

    {/* Under the heading: the numbers, each attributed. Stars belong to Svelte
        Commerce and say so; GitHub publishes no download count for a repo
        without releases, so the second figure is forks, which it does. */}
    <ul class="hero-stats" aria-label="By the numbers">
      <li><svg aria-hidden="true"><use href="#i-git"/></svg><b data-gh="sv-stars">1,813</b><span>GitHub stars, Svelte Commerce</span></li>
      <li><svg aria-hidden="true"><use href="#i-source"/></svg><b data-gh="sv-forks">335</b><span>forks on GitHub</span></li>
      <li><svg aria-hidden="true"><use href="#i-plug"/></svg><b>26</b><span>commerce backends connected</span></li>
    </ul>

    <p class="lede">
      Open source, and built to be quick: a backend that runs as one compiled
      process on one database, and a storefront that sends finished HTML
      instead of a bundle to boot. MIT licensed, hosted by you, no platform
      fees — up on your own server with a single command.
    </p>

    <div class="actions hero-actions">
      <a class="button" href="#one-command" data-ev="quickstart_click">Download now</a>
      <a class="button secondary" href="#live-admin" data-ev="live_admin_click">Live demo</a>
      <a class="button secondary" href="https://github.com/itswadesh/gocommerce#readme" target="_blank" rel="noopener noreferrer">Documentation</a>
    </div>

    <ul class="stack-row" aria-label="Built with">
      {stack.map((s) => <li><img src={s.src} width="26" height="26" alt="" loading="lazy"><span>{s.name}</span></li>)}
    </ul>

    <div class="plate">
      <p class="plate-head">Parts <span>Both MIT licensed. Either works without the other.</span></p>

      <div class="part part-engine">
        <p class="part-id">itswadesh/gocommerce</p>
        <div>
          <p class="part-name"><a href="/gocommerce/" data-ev="gocommerce_explore">GoCommerce</a></p>
          <p class="part-role">Backend and admin. One Go binary, one dependency, PostgreSQL.</p>
        </div>
        <ul class="part-figures">
          <li><b>44</b> modules</li>
          <li><b>342</b> API operations</li>
          <li><b>1,036</b> tests</li>
          <li><b>61</b> admin screens</li>
        </ul>
        <p class="part-cta"><a class="button" href="/gocommerce/" data-ev="gocommerce_explore">Explore GoCommerce</a></p>
      </div>

      <div class="part part-store">
        <p class="part-id">itswadesh/svelte-commerce</p>
        <div>
          <p class="part-name"><a href="/svelte-commerce/" data-ev="sveltecommerce_explore">Svelte Commerce</a></p>
          <p class="part-role">Storefront. SvelteKit, server-rendered, headless across 26 backends.</p>
        </div>
        <ul class="part-figures">
          <li><b>26</b> backends</li>
          <li><b>43</b> service surface</li>
          <li><b data-gh="sv-stars">1,813</b> stars</li>
          <li><b data-gh="sv-forks">335</b> forks</li>
        </ul>
        <p class="part-cta"><a class="button" href="/svelte-commerce/" data-ev="sveltecommerce_explore">Explore Svelte Commerce</a></p>
      </div>
    </div>

    <p class="hero-sub">
      <a href="#one-command" data-ev="quickstart_click">Run the whole thing with one command</a>
      <a href="https://github.com/itswadesh" target="_blank" rel="noopener noreferrer" data-ev="github_hero_click">Both repositories on GitHub</a>
    </p>
  </section>

  <section class="hero-shots" aria-label="The software">
    <div class="wrap hero-shots-grid">
      <figure class="dev-desktop">
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="/assets/admin/dashboard-dark.webp">
          <img src="/assets/admin/dashboard-light.webp" width="1440" height="900" alt="The GoCommerce admin dashboard: net sales for the last thirty days, order, product and customer counts, a daily sales chart and a best-sellers table." decoding="async" fetchpriority="high">
        </picture>
        <figcaption><span class="shot-mark shot-go"></span>GoCommerce admin, running against a seeded store</figcaption>
      </figure>
      <figure class="dev-phone">
        <img src="/assets/admin/storefront-mobile.webp" width="780" height="1688" alt="The Arialshop storefront on a phone: category tiles, a jewellery hero with a shop call to action, and a bottom navigation bar." decoding="async">
        <figcaption><span class="shot-mark shot-sv"></span>Svelte Commerce, on arialshop.com</figcaption>
      </figure>
    </div>
  </section>

  {/* ══════════════════════════════════════ 2 — proof strip */}
  {/* Twelve claims, each with the section that substantiates it. A label that
      links nowhere is an adjective; these link to the evidence. */}
  <section class="proofstrip proofstrip-12" aria-label="At a glance">
    <ul class="wrap proofstrip-row">
      <li><a href="#ownership"><svg aria-hidden="true"><use href="#i-source"/></svg>Open source</a></li>
      <li><a href="/gocommerce/#modules"><svg aria-hidden="true"><use href="#i-braces"/></svg>Open API</a></li>
      <li><a href="#ownership"><svg aria-hidden="true"><use href="#i-coin"/></svg>Free</a></li>
      <li><a href="#operations"><svg aria-hidden="true"><use href="#i-shield"/></svg>Enterprise grade</a></li>
      <li><a href="#speed"><svg aria-hidden="true"><use href="#i-server"/></svg>Scalable</a></li>
      <li><a href="#operations"><svg aria-hidden="true"><use href="#i-check"/></svg>Robust</a></li>
      <li><a href="#speed"><svg aria-hidden="true"><use href="#i-zap"/></svg>Fast</a></li>
      <li><a href="#one-command"><svg aria-hidden="true"><use href="#i-package"/></svg>Portable</a></li>
      <li><a href="#one-command"><svg aria-hidden="true"><use href="#i-terminal"/></svg>1-command deploy</a></li>
      <li><a href="#headless"><svg aria-hidden="true"><use href="#i-git"/></svg>Detachable</a></li>
      <li><a href="#headless"><svg aria-hidden="true"><use href="#i-plug"/></svg>Headless</a></li>
      <li><a href="https://discord.gg/GgdAeccwDR" target="_blank" rel="noopener noreferrer"><svg aria-hidden="true"><use href="#i-users"/></svg>Discord community</a></li>
    </ul>
  </section>

  {/* ══════════════════════════════════════ built with, scrolling */}
  <section class="marquee-section" aria-labelledby="marquee-title">
    <h2 id="marquee-title" class="vh">Built with</h2>
    <div class="marquee">
      <ul class="marquee-track">
        {marquee.map((s) => <li><img src={s.src} width="28" height="28" alt="" loading="lazy"><span>{s.name}</span></li>)}
        {marquee.map((s) => <li aria-hidden="true"><img src={s.src} width="28" height="28" alt="" loading="lazy"><span>{s.name}</span></li>)}
      </ul>
    </div>
  </section>

  {/* ══════════════════════════════════════ 3 — one command */}
  <section id="one-command" class="section onecmd-section" aria-labelledby="onecmd-title">
    <div class="wrap">
      <h2 id="onecmd-title">Start on your own server in minutes</h2>
      <p class="section-lede">
        Three services, one command. This compose file is served from this
        domain and was run end to end before it was published here.
      </p>

      <div class="onecmd-grid">
        <div class="code-block">
          <div class="code-head">
            <p><svg class="ic" aria-hidden="true"><use href="#i-terminal"/></svg>Get it and run it</p>
            <button class="copy" data-copy="code-compose-run" data-ev="docker_compose_copy">Copy</button>
          </div>
          <pre id="code-compose-run"><code set:html={composeCmd} /></pre>
          <p class="code-note"><a href="/docker-compose.yml">docker-compose.yml</a> · <a href="/env.example">env.example</a></p>
        </div>

        <div class="terminal" role="img" aria-label="Terminal output: postgres, gocommerce and web containers started, then a 200 from localhost.">
          <p class="term-bar"><span></span><span></span><span></span></p>
          <pre class="term"><code set:html={termOut} /></pre>
        </div>
      </div>

      <h3 class="sub">After one command</h3>
      <ul class="outcome">
        <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>PostgreSQL</b><span>the database GoCommerce owns</span></li>
        <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>Commerce API</b><span>342 documented operations</span></li>
        <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>Admin panel</b><span>compiled into the same binary</span></li>
        <li><svg aria-hidden="true"><use href="#i-check"/></svg><b>Reverse proxy</b><span>Caddy, so it answers on port 80</span></li>
      </ul>

      <div class="urls">
        <div class="url"><p class="url-what">Admin</p><p class="url-where"><code>http://localhost/</code></p><p class="url-note">Sign in with the email and password from your <code>.env</code>.</p></div>
        <div class="url"><p class="url-what">API documentation</p><p class="url-where"><code>http://localhost/docs</code></p><p class="url-note">The OpenAPI contract this build actually serves.</p></div>
        <div class="url"><p class="url-what">Catalogue</p><p class="url-where"><code>http://localhost/api/products</code></p><p class="url-note">Public and unauthenticated — the route a storefront calls.</p></div>
      </div>

      <p class="fineprint">
        <b>Svelte Commerce is behind a profile:</b> <code>docker compose --profile storefront up -d</code>
        adds it on port 3000. It renders, but cannot read from GoCommerce until the
        connector ships, so it is not in the default set —
        <a href="/gocommerce-svelte-commerce-connector/">see the connector status</a>.
        GoCommerce builds from source on first run, because no image is published yet.
      </p>
    </div>
  </section>

  {/* ══════════════════════════════════ 4 — live admin + gallery */}
  <section id="live-admin" class="section admin-section" aria-labelledby="live-admin-title">
    <div class="wrap">
      <h2 id="live-admin-title">See the admin before you install</h2>
      <p class="section-lede">
        A GoCommerce instance is deployed at <code>admin.kitcommerce.store</code>.
        <b>It requires a sign-in</b> — there is no guest account yet, so the link
        opens a login screen rather than a browsable demo. The screenshots are the
        honest preview until that changes.
      </p>

      <div class="actions">
        <a class="button secondary" href="https://admin.kitcommerce.store/" target="_blank" rel="noopener noreferrer" data-ev="live_admin_click">Open admin sign-in</a>
        <a class="button secondary" href="/gocommerce/#admin" data-ev="gocommerce_explore">Every screen, explained</a>
      </div>

      <div class="tabs" role="tablist" aria-label="Admin screens">
        <button role="tab" id="tab-dashboard" aria-controls="panel-dashboard" aria-selected="true"><svg class="ic" aria-hidden="true"><use href="#i-server"/></svg>Dashboard</button>
        <button role="tab" id="tab-products" aria-controls="panel-products" aria-selected="false" tabindex="-1"><svg class="ic" aria-hidden="true"><use href="#i-package"/></svg>Products</button>
        <button role="tab" id="tab-orders" aria-controls="panel-orders" aria-selected="false" tabindex="-1"><svg class="ic" aria-hidden="true"><use href="#i-bag"/></svg>Orders</button>
        <button role="tab" id="tab-inventory" aria-controls="panel-inventory" aria-selected="false" tabindex="-1"><svg class="ic" aria-hidden="true"><use href="#i-warehouse"/></svg>Inventory</button>
      </div>

      <div class="panel" role="tabpanel" id="panel-dashboard" aria-labelledby="tab-dashboard">
        <div class="stage"><picture><source media="(prefers-color-scheme: dark)" srcset="/assets/admin/dashboard-dark.webp"><img src="/assets/admin/dashboard-light.webp" width="1440" height="900" alt="The GoCommerce dashboard: net sales, order and customer counts, a daily sales chart and a best-sellers table." decoding="async"></picture></div>
      </div>
      <div class="panel" role="tabpanel" id="panel-products" aria-labelledby="tab-products" hidden>
        <div class="stage"><picture><source media="(prefers-color-scheme: dark)" srcset="/assets/admin/products-dark.webp"><img src="/assets/admin/products-light.webp" width="1440" height="900" alt="The products list showing sixty-four products with status, variant count, price, available stock and last-updated time." loading="lazy" decoding="async"></picture></div>
      </div>
      <div class="panel" role="tabpanel" id="panel-orders" aria-labelledby="tab-orders" hidden>
        <div class="stage"><picture><source media="(prefers-color-scheme: dark)" srcset="/assets/admin/orders-dark.webp"><img src="/assets/admin/orders-light.webp" width="1440" height="900" alt="The orders list showing two hundred and sixty orders with order number, customer, fulfillment status, payment status, item count and total." loading="lazy" decoding="async"></picture></div>
      </div>
      <div class="panel" role="tabpanel" id="panel-inventory" aria-labelledby="tab-inventory" hidden>
        <div class="stage"><picture><source media="(prefers-color-scheme: dark)" srcset="/assets/admin/inventory-dark.webp"><img src="/assets/admin/inventory-light.webp" width="1440" height="900" alt="The inventory screen showing stock on hand for each SKU across several warehouse locations." loading="lazy" decoding="async"></picture></div>
      </div>

      <p class="fineprint">
        Screenshots from a seeded instance: 64 products, 260 orders across 150
        days. Three more screens — plugins, payments and shipping — are on the
        <a href="/gocommerce/#admin">GoCommerce page</a>.
      </p>
    </div>
  </section>

  {/* ══════════════════════════════ 5 — solutions, Bagisto-shaped */}
  {/* Three full sections — headless, marketplace, B2B — each with copy on one
      side and a diagram of the real primitives on the other. No screenshot
      exists for vendors or price lists, so the visual is the data flow, which
      is the honest picture of the feature. D2C and channels follow compact. */}
  <section id="sol-headless" class="section wrap feature" aria-labelledby="fh-title">
    <div class="feature-copy">
      <p class="kicker">Headless E-commerce</p>
      <h2 id="fh-title">The storefront is yours. The backend is an API.</h2>
      <p class="section-lede">
        GoCommerce holds no templates and renders no pages. It serves 342
        documented operations over REST, published as OpenAPI, and any client that
        speaks HTTP can drive it — Svelte Commerce, Next.js, a native app, or a
        coding agent over MCP.
      </p>
      <ul class="tick">
        <li>Storefront and backend deploy, scale and fail independently</li>
        <li>Swap the storefront without touching an order</li>
        <li>The admin uses the same public contract, so nothing is hidden from you</li>
        <li>Svelte Commerce runs against 26 backends; GoCommerce is one target of many</li>
      </ul>
      <div class="actions">
        <a class="button" href="/go-svelte-ecommerce/" data-ev="architecture_click">See the architecture</a>
        <a class="button secondary" href="/svelte-commerce/backends/">26 backend integrations</a>
      </div>
    </div>
    <figure class="feature-visual flow" aria-labelledby="fh-cap">
      <figcaption id="fh-cap" class="flow-cap">Any client, one contract</figcaption>
      <div class="arch-row"><h3>Storefront, app, or agent</h3><p>Svelte Commerce · Next.js · iOS · MCP</p></div>
      <p class="arch-wire"><span>REST / JSON — OpenAPI</span></p>
      <div class="arch-row arch-engine"><h3>GoCommerce</h3><p>342 operations, 142 of them admin</p></div>
      <p class="arch-wire"><span>pgx</span></p>
      <div class="arch-row arch-data"><h3>PostgreSQL</h3></div>
    </figure>
  </section>

  <section id="sol-marketplace" class="section wrap feature feature-flip" aria-labelledby="fm-title">
    <div class="feature-copy">
      <p class="kicker">Multi-vendor marketplace</p>
      <h2 id="fm-title">Launch a marketplace where sellers are first-class</h2>
      <p class="section-lede">
        Vendors are sellers on your store, not brands on a product. A new seller
        arrives <em>pending</em> and is approved or suspended by you — because a
        marketplace that lists whoever signs up is not moderating, it is hosting
        whatever turns up.
      </p>
      <ul class="tick">
        <li>Vendor accounts with pending, approved and suspended states</li>
        <li>Vendor offers: several sellers, one catalogue entry, their own price and stock</li>
        <li>Orders carry the seller, so fulfilment and payout know whose goods moved</li>
        <li>Moderation is a state machine in the engine, not a checkbox in a theme</li>
      </ul>
      <div class="actions">
        <a class="button" href="/gocommerce/#use-cases" data-ev="gocommerce_explore">How marketplaces work in GoCommerce</a>
        <a class="button secondary" href="/gocommerce/#quickstart" data-ev="quickstart_click">Run it locally</a>
      </div>
      <p class="sol-prim">core/vendors.go — vendors, vendor offers, moderation states</p>
    </div>
    <figure class="feature-visual flow" aria-labelledby="fm-cap">
      <figcaption id="fm-cap" class="flow-cap">A seller's path through the engine</figcaption>
      <div class="arch-row"><h3>Seller signs up</h3><p>state: pending</p></div>
      <p class="arch-wire"><span>you review</span></p>
      <div class="arch-row arch-engine"><h3>Approved</h3><p>may list offers</p></div>
      <p class="arch-wire"><span>publishes</span></p>
      <div class="arch-row arch-store"><h3>Vendor offer</h3><p>own price, own stock, on your catalogue</p></div>
