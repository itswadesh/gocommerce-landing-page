---
/**
 * The privacy page says exactly what the code does, and is built from the
 * same config the code reads, so it cannot describe analytics the site does
 * not run. With no IDs configured it says "no analytics" and means it.
 */
import Base from '../layouts/Base.astro'

const path = '/privacy/'
const abs = (p: string) => new URL(p, Astro.site!).href

const cfg = {
  ga4: import.meta.env.PUBLIC_GA4_ID ?? '',
  clarity: import.meta.env.PUBLIC_CLARITY_ID ?? '',
  segment: import.meta.env.PUBLIC_SEGMENT_KEY ?? '',
  reo: import.meta.env.PUBLIC_REO_ID ?? '',
}
const wa = import.meta.env.PUBLIC_WHATSAPP ?? ''

const parties = [
  cfg.ga4 && { name: 'Google Analytics 4', who: 'Google', what: 'page views and the funnel events named below, under Consent Mode v2', policy: 'https://policies.google.com/privacy' },
  cfg.clarity && { name: 'Microsoft Clarity', who: 'Microsoft', what: 'session replays and heatmaps of how the page is used', policy: 'https://privacy.microsoft.com/privacystatement' },
  cfg.segment && { name: 'Segment', who: 'Twilio', what: 'the same funnel events, forwarded to whichever destinations are configured there', policy: 'https://www.twilio.com/en-us/legal/privacy' },
  cfg.reo && { name: 'Reo', who: 'Reo.dev', what: 'developer-intent signals from page activity', policy: 'https://www.reo.dev/privacy-policy' },
].filter(Boolean) as { name: string; who: string; what: string; policy: string }[]

const graph = [
  { '@type': 'WebPage', '@id': abs(path + '#page'), url: abs(path), name: 'Privacy', isPartOf: { '@id': abs('/#site') }, inLanguage: 'en' },
]
const ext = { target: '_blank', rel: 'noopener noreferrer' }
---
<Base
  title="Privacy — What kitcommerce.store Collects, and What It Does Not"
  description="What this website stores, which third parties it contacts, and what happens only after you allow analytics. Written from the site's own configuration, so it describes the code as built."
  path={path}
  ogTitle="Privacy — kitcommerce.store"
  ogDescription="What this site stores, which third parties it contacts, and what happens only with your consent."
  crumbs={[{ name: 'Privacy', href: path }]}
  graph={graph}
>
  <section class="wrap page-head">
    <h1>What this site knows about you</h1>
    <p class="lede">This page is generated from the same configuration the site runs on. If a service is not listed here, the site does not load it.</p>
  </section>

  <section id="always" class="section wrap" aria-labelledby="always-title">
    <h2 id="always-title">What happens on every visit</h2>
    <div class="tri">
      <div class="tri-item">
        <h3>Served by Cloudflare</h3>
        <p>The pages are static files on Cloudflare’s network. Cloudflare sees your IP address and request headers to deliver them, as any host does, and keeps its own <a href="https://www.cloudflare.com/privacypolicy/" {...ext}>operational logs</a>. Nothing on this site reads them.</p>
      </div>
      <div class="tri-item">
        <h3>One request to GitHub</h3>
        <p>The home page asks <code>api.github.com</code> for the current star counts of the two repositories. GitHub sees your IP address for that request. If it fails, the numbers measured at build time stay on the page.</p>
      </div>
      <div class="tri-item">
        <h3>Nothing else leaves</h3>
        <p>The typefaces are served from this domain. There are no embedded videos, no social widgets, no chat widget and no advertising. No cookies are set unless you allow analytics below.</p>
      </div>
    </div>
  </section>

  <section id="stored" class="section wrap" aria-labelledby="stored-title">
    <h2 id="stored-title">What is stored in your browser</h2>
    <ul class="tick">
      <li><b>Your analytics choice</b>, in <code>localStorage</code> under <code>kc-consent</code>, so the question is asked once. It holds the word <i>granted</i> or <i>denied</i> and a date, nothing else.</li>
      <li><b>The site itself</b>, cached by a service worker so pages open offline and updates apply without a refresh. This is a copy of public files, not a record of you.</li>
      <li><b>Nothing keyed to you.</b> No identifier is generated by this site. Clearing site data removes everything above.</li>
    </ul>
  </section>

  <section id="analytics" class="section wrap" aria-labelledby="analytics-title">
    <h2 id="analytics-title">Analytics, only after you say yes</h2>
    {parties.length === 0 ? (
      <div class="statement">
        <p class="statement-lead">This build runs no analytics.</p>
        <p>No measurement ID is configured, so no consent banner is shown, no analytics script is requested and no analytics cookie is set. When analytics are switched on, this page will list each service here and the banner will appear.</p>
      </div>
    ) : (
      <>
        <p class="section-lede">Nothing below loads until you choose <b>Allow analytics</b> on the banner. Decline, and none of it is ever requested. You can change your answer any time from the footer’s <b>Analytics preferences</b>.</p>
        <div class="tbl-scroll">
          <table class="reltable">
            <caption>Services loaded after consent</caption>
            <thead><tr><th scope="col">Service</th><th scope="col">Run by</th><th scope="col">What it records</th><th scope="col">Their policy</th></tr></thead>
            <tbody>
              {parties.map((p) => (
                <tr><th scope="row">{p.name}</th><td>{p.who}</td><td>{p.what}</td><td><a href={p.policy} {...ext}>Privacy policy</a></td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fineprint">Google’s tag is loaded with Consent Mode v2 defaults of <code>denied</code> for every storage type; they flip to <code>granted</code> only on your click. The funnel events sent are named in the page source: which project you chose, whether you copied the compose command, whether you went to GitHub or opened a question. No form fields, no keystrokes.</p>
      </>
    )}
  </section>

  <section id="contact" class="section wrap" aria-labelledby="contact-title">
    <h2 id="contact-title">Contacting us</h2>
    <p class="section-lede">Everything about the code is public, so questions are best asked in public too.</p>
    <div class="actions">
      <a class="button secondary" href="https://github.com/itswadesh/gocommerce/issues" {...ext}>GoCommerce issues</a>
      <a class="button secondary" href="https://github.com/itswadesh/svelte-commerce/discussions" {...ext}>Svelte Commerce discussions</a>
      <a class="button secondary" href="https://discord.gg/GgdAeccwDR" {...ext}>Discord</a>
      {wa && <a class="button secondary" href={`https://wa.me/${wa}`} {...ext}>WhatsApp</a>}
    </div>
    <p class="fineprint">{wa ? 'Messages to the WhatsApp number are handled by Meta under its own terms; nothing you send there is stored by this site.' : 'A WhatsApp contact will be added here when one is configured.'} The site links back to <a href="/">the home page</a>, <a href="/gocommerce/">GoCommerce</a> and <a href="/svelte-commerce/">Svelte Commerce</a>; none of those pages behave differently from this one.</p>
  </section>
</Base>
