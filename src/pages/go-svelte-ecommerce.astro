---
import Base from '../layouts/Base.astro'
import Faq from '../components/Faq.astro'

const path = '/go-svelte-ecommerce/'
const abs = (p: string) => new URL(p, Astro.site!).href

const graph = [
  { '@type': 'WebPage', '@id': abs(path + '#page'), url: abs(path), name: 'Go + Svelte Ecommerce Architecture', isPartOf: { '@id': abs('/#site') }, inLanguage: 'en', mentions: [{ '@id': abs('/gocommerce/#app') }, { '@id': abs('/svelte-commerce/#app') }] },
]

const faq = [
  { q: 'Do GoCommerce and Svelte Commerce require each other?', a: 'No. Both projects can be used independently, but they can also be combined to build a complete ecommerce stack. GoCommerce runs with no Svelte storefront in front of it, and Svelte Commerce runs against 26 backends that are not GoCommerce.' },
  { q: 'What is kitcommerce.store?', a: 'kitcommerce.store is the website that presents GoCommerce and Svelte Commerce, two open-source ecommerce projects. It is not itself a product, a platform or a framework, and there is nothing called KitCommerce to install.' },
  { q: 'Can Svelte Commerce work with another ecommerce backend?', a: 'Yes. Svelte Commerce is a headless storefront that reaches a backend through a connector package, and 26 connectors exist today — Litekart and Vendure are the most complete at 39 of 43 services. The storefront imports no connector by name, so switching backends is a package change rather than a rewrite.' },
  { q: 'Can GoCommerce work with another frontend?', a: 'Yes. GoCommerce exposes commerce backend functionality that any compatible storefront or application can consume. It serves 342 documented operations over REST, published as OpenAPI, so any framework that can call HTTP can drive it.' },
  { q: 'Can I run the two together today?', a: 'Not without writing the glue yourself. The connector that maps the GoCommerce API onto the Svelte Commerce data layer is in development and unpublished. Until it ships, pairing them means writing that client against the documented GoCommerce API.' },
  { q: 'Which should I start with?', a: 'Start with whichever solves the problem you actually have. If you need orders, inventory and an admin, start with GoCommerce. If you have a backend already and need a storefront, start with Svelte Commerce. Neither choice commits you to the other.' },
]

const flows = [
  {
    id: 'flow-c', cap: 'Shopper',
    rows: [
      { cls: '', h: 'Customer', p: 'Browsing, searching, buying.' },
      { wire: 'HTTPS' },
      { cls: 'arch-store', h: 'Svelte Commerce', p: 'Storefront. SvelteKit, server-rendered.' },
      { wire: 'REST / JSON — connector' },
      { cls: 'arch-engine', h: 'GoCommerce', p: 'Commerce API. Go.' },
      { wire: 'pgx' },
      { cls: 'arch-data', h: 'PostgreSQL', p: 'One database, yours.' },
    ],
  },
  {
    id: 'flow-m', cap: 'Merchant',
    rows: [
      { cls: '', h: 'Merchant', p: 'Fulfilling, pricing, restocking.' },
      { wire: 'HTTPS' },
      { cls: 'arch-admin', h: 'GoCommerce admin', p: 'Svelte, compiled into the Go binary.' },
      { wire: 'same documented API' },
      { cls: 'arch-engine', h: 'GoCommerce', p: 'Commerce API. Go.' },
      { wire: 'pgx' },
      { cls: 'arch-data', h: 'PostgreSQL', p: 'One database, yours.' },
    ],
  },
]
const ext = { target: '_blank', rel: 'noopener noreferrer' }
---
<Base
  title="Go + Svelte Ecommerce Architecture — How GoCommerce and Svelte Commerce Fit"
  description="How GoCommerce and Svelte Commerce fit together: a Go backend, a Svelte storefront, and two independent open-source projects that can be adopted separately or combined into a full Go + Svelte ecommerce architecture."
  path={path}
  ogTitle="Go + Svelte Ecommerce Architecture"
  ogDescription="A Go backend and a Svelte storefront. Two independent projects — use either alone, or combine them."
  ogImageAlt="Architecture of GoCommerce and Svelte Commerce: two flows meeting at one PostgreSQL"
  nav="architecture"
  crumbs={[{ name: 'Architecture', href: path }]}
  graph={graph}
  faq={faq}
>
  <section class="wrap page-head">
    <h1>Go backend. Svelte storefront. Independent projects.</h1>
    <p class="lede">This page explains the relationship between the two projects — what talks to what, which parts are real today, and when you would reach for one, the other, or both.</p>
  </section>

  <section id="flows" class="section wrap" aria-labelledby="flows-title">
    <h2 id="flows-title">Two flows, one database</h2>
    <p class="section-lede">A shopper and a merchant arrive by different routes and meet at the same Postgres. Nothing proxies for anything else.</p>

    <div class="flows">
      {flows.map((f) => (
        <figure class="flow" aria-labelledby={f.id}>
          <figcaption id={f.id} class="flow-cap">{f.cap}</figcaption>
          {f.rows.map((r) =>
            'wire' in r
              ? <p class="arch-wire"><span>{r.wire}</span></p>
              : <div class={`arch-row ${r.cls}`.trim()}><h3>{r.h}</h3><p>{r.p}</p></div>
          )}
        </figure>
      ))}
    </div>

    <p class="fineprint">The merchant path is worth noticing: the admin is a <em>client of the same published contract</em> an integration reads. There is no private channel the panel uses and you cannot — its 142 endpoints are privileged, not undocumented. <a href="/#live-admin">See the live admin</a>.</p>
  </section>

  <section id="independent" class="section wrap" aria-labelledby="ind-title">
    <h2 id="ind-title">They do not require each other</h2>
    <div class="statement">
      <p class="statement-lead">GoCommerce and Svelte Commerce are independent open-source projects. Either can be used without the other.</p>
      <p>GoCommerce runs with no Svelte storefront in front of it, serving any client that speaks HTTP. Svelte Commerce runs against <a href="/svelte-commerce/backends/">26 commerce backends</a>, none of which is GoCommerce.</p>
      <p class="statement-note">A direct connector between GoCommerce and Svelte Commerce is currently <b>in development</b>. Until it is published, running the two together means writing that client yourself. <a href="/gocommerce-svelte-commerce-connector/">See the connector status</a>.</p>
    </div>
  </section>

  <section id="when" class="section wrap" aria-labelledby="when-title">
    <h2 id="when-title">When to use each</h2>
    <div class="tri">
      <div class="tri-item tri-engine">
        <h3>Use GoCommerce when you need</h3>
        <ul class="tick">
          <li>a commerce backend</li>
          <li>REST / OpenAPI</li>
          <li>an admin panel</li>
          <li>orders and fulfillment</li>
          <li>inventory across locations</li>
          <li>customers and pricing rules</li>
        </ul>
        <a class="button secondary" href="/gocommerce/">Explore GoCommerce</a>
      </div>
      <div class="tri-item tri-store">
        <h3>Use Svelte Commerce when you need</h3>
        <ul class="tick">
          <li>a storefront</li>
          <li>a Svelte / SvelteKit frontend</li>
          <li>backend flexibility</li>
          <li>a custom commerce UI</li>
          <li>server-rendered product pages</li>
          <li>to keep the backend you have</li>
        </ul>
        <a class="button secondary" href="/svelte-commerce/">Explore Svelte Commerce</a>
      </div>
      <div class="tri-item">
        <h3>Use both when you want</h3>
        <ul class="tick">
          <li>a Go backend</li>
          <li>a Svelte storefront</li>
          <li>one database you run</li>
          <li>a fully owned open-source stack</li>
          <li>no hosted control plane</li>
          <li>and can write the connector today</li>
        </ul>
        <a class="button secondary" href="/gocommerce-svelte-commerce-connector/">Connector status</a>
      </div>
    </div>
  </section>

  <section id="compare" class="section wrap" aria-labelledby="compare-title">
    <h2 id="compare-title">Side by side</h2>
    <div class="tbl-scroll">
      <table class="reltable">
        <caption>GoCommerce and Svelte Commerce compared</caption>
        <thead>
          <tr>
            <th scope="col"><span class="vh">Property</span></th>
            <th scope="col">GoCommerce</th>
            <th scope="col">Svelte Commerce</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">Role</th><td>Backend + admin</td><td>Storefront</td></tr>
          <tr><th scope="row">Primary language</th><td>Go</td><td>Svelte / SvelteKit</td></tr>
          <tr><th scope="row">Can be used standalone</th><td>Yes</td><td>Yes</td></tr>
          <tr><th scope="row">Can work together</th><td colspan="2">Yes — connector in development</td></tr>
          <tr><th scope="row">Open source</th><td>MIT</td><td>MIT</td></tr>
          <tr><th scope="row">Maturity</th><td>1.0 — stable contract, no production mileage yet</td><td>Public for years, running production stores</td></tr>
          <tr><th scope="row">Runs against</th><td>PostgreSQL</td><td><a href="/svelte-commerce/backends/">26 commerce backends</a></td></tr>
          <tr><th scope="row">One-command deploy</th><td><a href="/#one-command">Docker Compose, three services</a></td><td>Same compose file, <code>--profile storefront</code></td></tr>
          <tr>
            <th scope="row">Repository</th>
            <td><a href="https://github.com/itswadesh/gocommerce" {...ext}><code>itswadesh/gocommerce</code></a></td>
            <td><a href="https://github.com/itswadesh/svelte-commerce" {...ext}><code>itswadesh/svelte-commerce</code></a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <Faq items={faq} title="How the two projects relate" />

  <section class="closing wrap">
    <h2>Pick the piece you need</h2>
    <p>Neither project asks you to adopt the other.</p>
    <div class="actions">
      <a class="button" href="/gocommerce/">Explore GoCommerce</a>
      <a class="button" href="/svelte-commerce/">Explore Svelte Commerce</a>
      <a class="button secondary" href="/gocommerce-svelte-commerce-connector/">Connector status</a>
    </div>
  </section>
</Base>
