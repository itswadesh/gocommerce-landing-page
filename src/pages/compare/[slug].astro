---
/**
 * One comparison page per file in src/data/compare/. The data file is the
 * page: its facts, its sources, the date they were checked. This template
 * only decides where each fact sits, so twenty comparisons cannot drift into
 * twenty layouts, and a price that changes is a one-line edit with a commit
 * that re-dates the page (see src/lib/dates.mjs).
 *
 * The title and h1 lead with the query people type ("Shopify alternative"),
 * not the brand, which nobody searches yet. The body always compares GoCommerce and Svelte Commerce — the two packages
 * of KitCommerce — and every page says so under the heading, because a claim
 * names the package it is about.
 *
 * Every page carries the same "what you take on" column. A comparison that
 * lists only the other side's costs is an advert, and this site does not
 * publish those.
 */
import Base from '../../layouts/Base.astro'
import Faq from '../../components/Faq.astro'
import Priced from '../../components/Priced.astro'
import CurrencyPicker from '../../components/CurrencyPicker.astro'
import type { Comparison } from '../../data/compare/_schema'
import LinkCards from '../../components/LinkCards.astro'
import Variants from '../../components/Variants.astro'
import { fill, gstForRupees, hostedFee, plusGst, signupUrl } from '../../lib/pricing'
import { compareCard, comparisons, siblingComparisons } from '../../lib/related'
import { byCurrency, currencyRefs, listsFor, plain, refsIn } from '../../lib/money'

export function getStaticPaths() {
  return comparisons.map((c) => ({ params: { slug: c.slug }, props: { c } }))
}

const c = fill((Astro.props as { c: Comparison }).c)
const siblings = siblingComparisons(c).map(compareCard)
const path = `/compare/${c.slug}/`
const abs = (p: string) => new URL(p, Astro.site!).href
const ext = { target: '_blank', rel: 'noopener noreferrer' }
const longDate = (iso: string) => new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
const checked = longDate(c.checked)

// Prices come from src/data/prices.json in every currency; each price list
// the page draws on joins its Sources, with the date it was read.
const refs = refsIn(c)
const varying = currencyRefs(refs)
const sources = [
  ...c.sources,
  ...listsFor(refs).filter((l) => !c.sources.some((s) => s.url.split('?')[0] === l.url.split('?')[0])).map((l) => ({ label: `${l.label}, read ${longDate(l.read)}`, url: l.url })),
]
const faqText = c.faq.map((f) => ({ q: plain(f.q), a: plain(f.a) }))

const graph = [
  {
    '@type': 'WebPage', '@id': abs(path + '#page'), url: abs(path), name: c.title, isPartOf: { '@id': abs('/#site') }, inLanguage: 'en',
    about: [
      { '@type': 'SoftwareApplication', name: c.platform, url: c.platformUrl, applicationCategory: 'BusinessApplication' },
      { '@id': abs('/gocommerce/#app') },
      { '@id': abs('/svelte-commerce/#app') },
    ],
  },
]

// A page that prices Shopify links the calculator, under its cost table or, without one, under the side-by-side.
const calcLink = refs.some((r) => r.startsWith('shopify/'))

// The hosted fee's GST: always on a page for Indian stores; for rupee
// visitors on a page with a currency picker; elsewhere nothing.
const india = c.market === 'IN'
const gst = india ? byCurrency(() => `, ${plusGst}`) : varying.length > 0 ? gstForRupees : []

// What running a self-hosted MIT platform asks of you, said the same way on
// every page. Page data can add to it; it cannot remove from it.
const takeOn = [
  `Run it yourself and you host it: a server, a PostgreSQL database, backups and upgrades are yours, or a developer’s you pay. A store hosted on kitcommerce.store pays ${hostedFee} of each successful sale${india ? `, ${plusGst},` : ''} instead.`,
  'No app store. What a module does not cover, somebody writes.',
  'GoCommerce has over 1,000 tests, but no store we know of runs it in production yet.',
  'Svelte Commerce reaches GoCommerce through an early connector, version 0.1.0: catalogue, cart, checkout and order lookup work; customer accounts and a search index do not.',
  ...(c.takeOnExtra ?? []),
]
---
<Base
  title={plain(c.title)}
  description={plain(c.description)}
  path={path}
  ogTitle={plain(c.ogTitle)}
  ogDescription={plain(c.ogDescription)}
  crumbs={[{ name: 'Compare', href: '/compare/' }, { name: c.label, href: path }]}
  graph={graph}
  faq={faqText}
  prices={varying.length > 0}
>
  <section class="wrap page-head">
    <p class="kicker">{c.label}</p>
    <h1 class="h1-long"><Priced s={c.h1} /></h1>
    {c.tagline && <p class="tagline"><Priced s={c.tagline} /></p>}
    <p class="lede"><Priced s={c.lede} /></p>
    <ul class="head-facts">
      {c.facts.map((f) => <li><b><Priced s={f.b} /></b> <Priced s={f.t} /></li>)}
    </ul>
    {varying.length > 0 && <CurrencyPicker refs={varying} />}
    <p class="fineprint vs-meaning">KitCommerce is an open-source ecommerce platform. Its packages are GoCommerce, the backend and admin, and Svelte Commerce, the storefront — MIT licensed, used together or either one on its own. Run them yourself for free, or <a href={signupUrl} {...ext} data-ev="signup_click">start a store hosted on kitcommerce.store</a> for {hostedFee} of each successful sale<Variants v={gst} />. On this page, each claim names the package it is about.</p>
  </section>

  <section id="glance" class="section wrap" aria-labelledby="glance-title">
    <h2 id="glance-title">{c.platform} and GoCommerce, side by side</h2>
    <p class="section-lede"><Priced s={c.glanceLede} /></p>
    <div class="tbl-scroll">
      <table class="reltable vs">
        <caption>{c.platform} compared with GoCommerce and Svelte Commerce, checked {checked}</caption>
        <thead>
          <tr><th scope="col"><span class="vh">Aspect</span></th><th scope="col">{c.platform}</th><th scope="col">GoCommerce + Svelte Commerce</th></tr>
        </thead>
        <tbody>
          {c.rows.map(([aspect, them, us]) => (
            <tr><th scope="row"><Priced s={aspect} /></th><td><Priced s={them} /></td><td><Priced s={us} /></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {c.cost && (
    <section id="cost" class="section wrap" aria-labelledby="cost-title">
      <h2 id="cost-title">{c.cost.title}</h2>
      <p class="section-lede"><Priced s={c.cost.lede} /></p>
      <div class="tbl-scroll">
        <table class="reltable vs">
          <caption>{c.cost.caption}</caption>
          <thead>
            <tr>{c.cost.head.map((h, i) => <th scope="col">{i === 0 ? <span class="vh">{h}</span> : h}</th>)}</tr>
          </thead>
          <tbody>
            {c.cost.rows.map(([first, ...rest]) => (
              <tr><th scope="row"><Priced s={first} /></th>{rest.map((cell) => <td><Priced s={cell} /></td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      {c.cost.note && <p class="fineprint"><Priced s={c.cost.note} /></p>}
      {calcLink && <p class="fineprint"><a href="/pricing/fee-calculator/">Work out Shopify’s fees on your own sales</a>, in your currency, against {hostedFee} of each sale hosted<Variants v={gst} />.</p>}
    </section>
  )}

  <section id="choose" class="section wrap" aria-labelledby="choose-title">
    <h2 id="choose-title">Which one fits</h2>
    <div class="tri">
      <div class="tri-item">
        <h3>Choose {c.platform} when</h3>
        <ul class="tick">{c.themWhen.map((t) => <li><Priced s={t} /></li>)}</ul>
      </div>
      <div class="tri-item tri-engine">
        <h3>Choose GoCommerce + Svelte Commerce when</h3>
        <ul class="tick">{c.usWhen.map((t) => <li><Priced s={t} /></li>)}</ul>
      </div>
      <div class="tri-item">
        <h3>What you take on</h3>
        <ul class="tick">{takeOn.map((t) => <li><Priced s={t} /></li>)}</ul>
      </div>
    </div>
  </section>

  {c.move && (
    <section id="move" class="section wrap" aria-labelledby="move-title">
      <h2 id="move-title">{c.move.title}</h2>
      <div class="statement">
        {c.move.paras.map((p, i) => <p class={i === 0 ? 'statement-lead' : undefined}><Priced s={p} /></p>)}
      </div>
    </section>
  )}

  <Faq items={c.faq} title={`Questions about ${c.platform} and GoCommerce`} />

  {siblings.length > 0 && (
    <LinkCards id="more" title={`More comparisons: ${c.group}`} items={siblings}>
      <p class="section-lede">The same questions, asked of the platforms {c.platform} is usually weighed against. <a href="/compare/">Every comparison</a> is on one page.</p>
    </LinkCards>
  )}

  <section class="section wrap vs-sources" aria-labelledby="sources-title">
    <h2 id="sources-title" class="vs-sources-title">Sources</h2>
    <p class="fineprint">{c.platform}’s prices and features were checked on {checked} against the pages below. Prices change; when one here disagrees with the source, the source is right and this page is out of date. {c.platform} is a trademark of its owner, named here only to compare; no endorsement or affiliation is implied — see <a href="/about/#trademarks">trademarks</a>.</p>
    <ul class="vs-source-list">
      {sources.map((s) => <li><a href={s.url} {...ext}>{s.label}</a></li>)}
    </ul>
  </section>

  <section class="closing wrap">
    <h2>Run it before you decide</h2>
    <p>The one-command stack gives you GoCommerce’s API and admin on your own machine in minutes. Load a catalogue and judge it against {c.platform} yourself.</p>
    <div class="actions">
      <a class="button" href="/#one-command" data-ev="quickstart_click">Deploy in minutes</a>
      <a class="button secondary" href="/gocommerce/">Explore GoCommerce</a>
      <a class="button secondary" href="/compare/">All comparisons</a>
    </div>
  </section>
</Base>
