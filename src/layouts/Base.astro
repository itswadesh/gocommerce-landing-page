---
/**
 * The one document shell. Every page passes its facts once — title, path,
 * crumbs, FAQ — and this file renders them everywhere they need to appear:
 * <title>, canonical, og:url, the visible breadcrumb trail, BreadcrumbList,
 * FAQPage. One source, several renderings, none of them hand-copied.
 *
 * Analytics ship dark. The IDs come from PUBLIC_* env at build time; with none
 * set, no banner renders and no third-party script is ever requested. With
 * IDs set, nothing loads until the visitor grants consent — see app.js.
 */
import '../styles/global.css'
import '../styles/skin.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Consent from '../components/Consent.astro'
import { pageDates } from '../lib/dates.mjs'

export interface Crumb { name: string; href: string }
export interface FaqItem { q: string; a: string }

interface Props {
  title: string
  description: string
  /** Canonical path with trailing slash, e.g. "/gocommerce/". */
  path: string
  ogTitle?: string
  ogDescription?: string
  ogImageAlt?: string
  /** Which top-nav item is current. */
  nav?: 'gocommerce' | 'svelte-commerce' | 'solutions' | 'develop' | 'architecture' | 'live-admin' | 'connector' | 'backends'
  /** Visible trail + BreadcrumbList. Home is implied as the first item. */
  crumbs?: Crumb[]
  /** Renders FAQPage JSON-LD; the page renders the same array visibly. */
  faq?: FaqItem[]
  /** Page-specific JSON-LD nodes, joined into the site graph by @id. */
  graph?: Record<string, unknown>[]
  noindex?: boolean
}

const {
  title, description, path,
  ogTitle = title, ogDescription = description,
  ogImageAlt = 'GoCommerce and Svelte Commerce — fast, open-source ecommerce you host yourself',
  nav, crumbs = [], faq = [], graph = [], noindex = false,
} = Astro.props

const site = Astro.site!
const abs = (p: string) => new URL(p, site).href
const canonical = abs(path)

const trail: Crumb[] = [{ name: 'Home', href: '/' }, ...crumbs]

// Analytics config, read once here and once in Consent.astro from the same
// env — the banner and the loader cannot disagree about who loads.
const cfg = {
  ga4: import.meta.env.PUBLIC_GA4_ID ?? '',
  clarity: import.meta.env.PUBLIC_CLARITY_ID ?? '',
  segment: import.meta.env.PUBLIC_SEGMENT_KEY ?? '',
  reo: import.meta.env.PUBLIC_REO_ID ?? '',
}

// The entity graph. Organization publishes the *website* — that is all
// kitcommerce.store is — and the two applications are owned by their own
// pages, which pass themselves in via `graph`. Social profiles belong in
// sameAs; four are pending their URLs.
const org = {
  '@type': 'Organization',
  '@id': abs('/#org'),
  name: 'KitCommerce',
  url: abs('/'),
  logo: abs('/assets/icons/icon-512.png'),
  description: 'The website presenting GoCommerce and Svelte Commerce, two independent open-source ecommerce projects.',
  sameAs: [
    'https://github.com/itswadesh/gocommerce',
    'https://github.com/itswadesh/svelte-commerce',
    'https://github.com/itswadesh',
    'https://discord.gg/GgdAeccwDR',
  ],
}
const website = { '@type': 'WebSite', '@id': abs('/#site'), name: 'kitcommerce.store', url: abs('/'), publisher: { '@id': abs('/#org') }, inLanguage: 'en' }
const breadcrumbList = {
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })),
}
// Dates from git: the page node carries when its source was last committed,
// the footer says the same in words, the sitemap says it in lastmod. A page
// that defines no WebPage node of its own gets one here so the date has
// somewhere to live.
const dates = pageDates(path)
const stamp = dates.exact ? { dateModified: dates.modified, ...(dates.published ? { datePublished: dates.published } : {}) } : {}
const isPage = (n: Record<string, unknown>) => n['@type'] === 'WebPage' || n['@type'] === 'CollectionPage'
const dated = graph.map((n) => (isPage(n) ? { ...n, ...stamp } : n))
const ownPage = graph.some(isPage) ? [] : [{ '@type': 'WebPage', '@id': canonical + '#page', url: canonical, name: title, isPartOf: { '@id': abs('/#site') }, inLanguage: 'en', ...stamp }]
const jsonld = { '@context': 'https://schema.org', '@graph': [org, website, ...dated, ...ownPage, breadcrumbList] }
const faqld = faq.length
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', '@id': canonical + '#faq', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
  : null

// Rendered only when a number is configured; never a placeholder.
const wa = import.meta.env.PUBLIC_WHATSAPP ?? ''

const robots = noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
{/* The reader's chosen theme, applied before first paint so a dark page never
    flashes white. The choice lives in localStorage under kc-theme. */}
<script is:inline>(function(){try{var t=localStorage.getItem('kc-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t)}}catch(e){}})()</script>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%230f1720'/%3E%3Cg fill='%23ffffff'%3E%3Crect x='4' y='4' width='3.6' height='16' rx='1'/%3E%3Cpath d='M9.6 12 15.4 4h4.4l-5.8 8z'/%3E%3Cpath d='M9.6 12h4.4l5.8 8h-4.4z'/%3E%3C/g%3E%3C/svg%3E">
{!noindex && <link rel="canonical" href={canonical}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="kitcommerce.store">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={abs('/assets/og.png')}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta property="og:locale" content="en">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={abs('/assets/og.png')}>
<link rel="preload" href="/assets/fonts/geist.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/source-serif-4.woff2" as="font" type="font/woff2" crossorigin>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<script is:inline set:html={`window.KC_CONFIG=${JSON.stringify(cfg)}`} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />
{faqld && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqld)} />}
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

{/* One sprite, referenced with <use>. Icons replace words; all decorative. */}
<svg class="sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <symbol id="i-source" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></symbol>
  <symbol id="i-server" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="7" rx="2"/><rect x="2" y="14" width="20" height="7" rx="2"/><path d="M6 6.5h.01M6 17.5h.01"/></symbol>
  <symbol id="i-plug" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6M15 2v6M6 8h12v3a6 6 0 0 1-12 0z"/><path d="M12 17v5"/></symbol>
  <symbol id="i-braces" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"/></symbol>
  <symbol id="i-coin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m5 5 14 14"/></symbol>
  <symbol id="i-bot" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 4v4M9 14h.01M15 14h.01"/></symbol>
  <symbol id="i-package" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.3 9 5.2M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></symbol>
  <symbol id="i-bag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/></symbol>
  <symbol id="i-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/></symbol>
  <symbol id="i-warehouse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 8.4V21H2V8.4a2 2 0 0 1 1.2-1.8l8-3.4a2 2 0 0 1 1.6 0l8 3.4A2 2 0 0 1 22 8.4z"/><path d="M6 18h12v-6H6z"/></symbol>
  <symbol id="i-card" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></symbol>
  <symbol id="i-truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6H2v12h2"/><path d="M14 9h4l4 4v5h-2"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></symbol>
  <symbol id="i-return" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></symbol>
  <symbol id="i-db" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/></symbol>
  <symbol id="i-tag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 12 22l-9-9V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><path d="M7.5 7.5h.01"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></symbol>
  <symbol id="i-webhook" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 16.98h-5.99M6 17a4 4 0 1 0 4-4"/><path d="M8.5 8.5a4 4 0 1 1 7 2.5"/></symbol>
  <symbol id="i-terminal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m4 17 6-5-6-5M12 19h8"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></symbol>
  <symbol id="i-store" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 3 1 6h16l1-6M4 9v12h16V9"/><path d="M9 21v-6h6v6"/></symbol>
  <symbol id="i-git" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="9" r="2.5"/><path d="M6 8.5v7M18 11.5a6 6 0 0 1-6 6H6"/></symbol>
  <symbol id="i-zap" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></symbol>
  <symbol id="i-whatsapp" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></symbol>
</svg>

<Header current={nav} />

<main id="main">
  {trail.length > 1 && <Breadcrumbs items={trail} />}
  <slot />
</main>

<Footer updated={dates.exact ? dates.modified : undefined} />

{wa && (
  <a class="wa-fab" href={`https://wa.me/${wa}`} target="_blank" rel="noopener noreferrer" data-ev="whatsapp_click">
    <svg aria-hidden="true"><use href="#i-whatsapp"/></svg><span>Chat on WhatsApp</span>
  </a>
)}
<Consent />
<div id="toast" role="status"></div>
<script src="/app.js" defer is:inline></script>
</body>
</html>
